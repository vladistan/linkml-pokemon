pokemon:Berry a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pokemon:Flavor ;
            sh:description "A Pokemon has a flavor" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path pokemon:hasFlavor ],
        [ sh:datatype xsd:string ;
            sh:description "A description of the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pokemon:firmness ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pokemon:smoothness ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:anyURI ;
            sh:description "A unique identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path linkml_common:identifier ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pokemon:hasSize ] ;
    sh:targetClass pokemon:Berry .

