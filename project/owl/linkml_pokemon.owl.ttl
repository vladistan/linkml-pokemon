        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:applicableUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:belongsToSystemOfQuantities ],
        [ a owl:Restriction ;
