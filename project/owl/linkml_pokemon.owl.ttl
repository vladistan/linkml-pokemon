@prefix dbpedia: <http://dbpedia.org/ontology/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix pokemon: <https://pokemonkg.org/ontology#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

qudt:QuantityKindDimensionVectorCGS a owl:Class ;
    rdfs:label "QuantityKindDimensionVector_CGS" ;
    rdfs:subClassOf qudt:QuantityKindDimensionVector ;
    skos:definition "CGS dimension vector" ;
    skos:exactMatch qudt:QuantityKindDimensionVector_CGS ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:QuantityKindDimensionVectorISO a owl:Class ;
    rdfs:label "QuantityKindDimensionVector_ISO" ;
    rdfs:subClassOf qudt:QuantityKindDimensionVector ;
    skos:definition "ISO dimension vector" ;
    skos:exactMatch qudt:QuantityKindDimensionVector_ISO ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:QuantityKindDimensionVectorImperial a owl:Class ;
    rdfs:label "QuantityKindDimensionVector_Imperial" ;
    rdfs:subClassOf qudt:QuantityKindDimensionVector ;
    skos:definition "Imperial dimension vector" ;
    skos:exactMatch qudt:QuantityKindDimensionVector_Imperial ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:QuantityKindDimensionVectorSI a owl:Class ;
    rdfs:label "QuantityKindDimensionVector_SI" ;
    rdfs:subClassOf qudt:QuantityKindDimensionVector ;
    skos:definition "SI dimension vector" ;
    skos:exactMatch qudt:QuantityKindDimensionVector_SI ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

pokemon:BattleItem a owl:Class ;
    rdfs:label "BattleItem" ;
    rdfs:subClassOf pokemon:Item ;
    skos:definition "Battle items are items that can be used during battles." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Berry a owl:Class ;
    rdfs:label "Berry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:hasSize ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasSize ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Quantity ;
            owl:onProperty pokemon:hasSize ],
        pokemon:Food ;
    skos:definition "Berries are small, juicy, fleshy fruit. As in the real world, a large variety exists in the Pokémon world, with a large range of flavors, names, and effects. First found in the Generation II games, many Berries have since became critical help items in battle, where their various effects include HP and status condition restoration, stat enhancement, and even damage negation." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Game a owl:Class ;
    rdfs:label "Game" ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "A game is a type of media that can be played by people." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Generation a owl:Class ;
    rdfs:label "Generation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Species ;
            owl:onProperty pokemon:featuresSpecies ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:featuresSpecies ],
        owl:Thing ;
    skos:definition "Generations refers to the Pokémon game series. It is a group of games that were released at or around the same time. It also means that games in the same generation are compatible with the others, containing the same Pokémon and the number of moves there are to be learned." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Gym a owl:Class ;
    rdfs:label "Gym" ;
    rdfs:subClassOf pokemon:Place ;
    skos:definition "A gym is a location that can be battled at." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:GymLeader a owl:Class ;
    rdfs:label "GymLeader" ;
    rdfs:subClassOf pokemon:Trainer ;
    skos:definition "A gym leader is the highest ranking member and owner of an official Pokémon gym. Gym leaders use their gym and their Pokémon to test the skills of trainers that challenge them, and if said trainers win a battle, the gym leader will gift them a badge that's unique to that specific gym." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:HM a owl:Class ;
    rdfs:label "HM" ;
    rdfs:subClassOf pokemon:Item ;
    skos:definition "Hidden Machine" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:HoldItem a owl:Class ;
    rdfs:label "HoldItem" ;
    rdfs:subClassOf pokemon:Item ;
    skos:definition "A hold item is an item that can be held by a Pokémon." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:LearningByLevelingUp a owl:Class ;
    rdfs:label "LearningByLevelingUp" ;
    rdfs:subClassOf pokemon:MoveLearning ;
    skos:definition "A move that is learned by leveling up." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:LearningThroughBreeding a owl:Class ;
    rdfs:label "LearningThroughBreeding" ;
    rdfs:subClassOf pokemon:MoveLearning ;
    skos:definition "A move that is learned by breeding." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Medicine a owl:Class ;
    rdfs:label "Medicine" ;
    rdfs:subClassOf pokemon:Item ;
    skos:definition "Medicine items can heal various afflictions of a Pokémon." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:PhysicalMove a owl:Class ;
    rdfs:label "PhysicalMove" ;
    rdfs:subClassOf pokemon:Move ;
    skos:definition "A physical move is a type of move that can be used during battles." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Pokeball a owl:Class ;
    rdfs:label "Pokeball" ;
    rdfs:subClassOf pokemon:Item ;
    skos:definition "A Poké Ball is a type of item that is critical to a Trainer's quest, used for catching and storing Pokémon." ;
    skos:exactMatch pokemon:Pok%C3%A9ball ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Pokemon a owl:Class ;
    rdfs:label "Pokemon" ;
    rdfs:seeAlso "<https://dbpedia.org/resource/Pokémon>" ;
    skos:definition "A Pokémon" ;
    skos:exactMatch pokemon:Pok%C3%A9mon ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:subClassOf pokemon:Place ;
    skos:definition "Regions are areas in the Pokémon universe that are smaller parts of a nation." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:SpecialMove a owl:Class ;
    rdfs:label "SpecialMove" ;
    rdfs:subClassOf pokemon:Move ;
    skos:definition "A special move is a type of move that can be used during battles." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:StatusMove a owl:Class ;
    rdfs:label "StatusMove" ;
    rdfs:subClassOf pokemon:Move ;
    skos:definition "A status move is a type of move that can be used during battles." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:TM a owl:Class ;
    rdfs:label "TM" ;
    rdfs:subClassOf pokemon:Item,
        pokemon:MoveLearning ;
    skos:definition "A Technical Machine is an item that can be used to teach a Pokémon a move." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Town a owl:Class ;
    rdfs:label "Town" ;
    rdfs:subClassOf pokemon:Place ;
    skos:definition "A town is a type of place that can be visited." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:accuracy a owl:DatatypeProperty ;
    rdfs:label "accuracy" ;
    rdfs:domain pokemon:Move ;
    rdfs:range xsd:integer ;
    skos:definition "Chance of a move successfully hitting the target, as a percentage." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:basePower a owl:DatatypeProperty ;
    rdfs:label "basePower" ;
    rdfs:domain pokemon:Move ;
    rdfs:range xsd:integer ;
    skos:definition "Base damage output of a move before applying type effectiveness and stat modifiers." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:basePowerPoints a owl:DatatypeProperty ;
    rdfs:label "basePowerPoints" ;
    rdfs:domain pokemon:Move ;
    rdfs:range xsd:integer ;
    skos:definition "Starting number of times a move can be used before needing restoration." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:containsPlace a owl:AsymmetricProperty,
        owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "containsPlace" ;
    rdfs:domain pokemon:Place ;
    rdfs:range pokemon:Place ;
    owl:inverseOf pokemon:locatedIn ;
    skos:definition "A place is contained to some extent in this place." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:describedInPokedex a owl:ObjectProperty ;
    rdfs:label "describedInPokedex" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:PokedexEntry ;
    owl:inverseOf pokemon:describesPokemon ;
    skos:definition "['A Pokédex entry is described in a Pokédex']" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:entryNumber a owl:DatatypeProperty ;
    rdfs:label "entryNumber" ;
    rdfs:domain pokemon:PokedexEntry ;
    rdfs:range xsd:integer ;
    skos:definition "The unique number identifying this entry within a Pokédex." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasPokedexEntry a owl:ObjectProperty ;
    rdfs:label "hasPokedexEntry" ;
    rdfs:domain pokemon:Pokedex ;
    rdfs:range pokemon:PokedexEntry ;
    skos:definition "A Pokédex entry in which this Pokémon is described." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:learnsMove a owl:ObjectProperty ;
    rdfs:label "learnsMove" ;
    rdfs:domain pokemon:MoveLearning ;
    rdfs:range pokemon:Move ;
    skos:definition "The move acquired through this particular learning method." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:maxPowerPoints a owl:DatatypeProperty ;
    rdfs:label "maxPowerPoints" ;
    rdfs:domain pokemon:Move ;
    rdfs:range xsd:integer ;
    skos:definition "Maximum times a move can be used after PP-enhancing items are applied." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:minLevelToLearn a owl:DatatypeProperty ;
    rdfs:label "minLevelToLearn" ;
    rdfs:range xsd:integer ;
    skos:definition "The minimum level a Pokémon needs to reach to learn this move." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

<https://pokemonkg.org/ontology.owl.ttl> a owl:Ontology ;
    rdfs:label "linkml-pokemon" ;
    dcterms:description "Ontology covering the Pokémon world as it is presented in games and anime television series." ;
    dcterms:issued "2019-07-27^^xsd:date" ;
    dcterms:license "MIT" ;
    dcterms:title "Pokémon Ontology" ;
    pav:createdOn "2019-07-27T00:00:00" ;
    rdfs:seeAlso <https://vladistan.github.io/linkml-pokemon> ;
    skos:definition "Ontology covering the Pokémon world as it is presented in games and anime television series" .

qudt:DecimalPrefix a owl:Class ;
    rdfs:label "DecimalPrefix" ;
    rdfs:subClassOf qudt:Prefix ;
    skos:definition "Decimal prefix (powers of 10)" ;
    skos:exactMatch qudt:DecimalPrefix ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:DerivedUnit a owl:Class ;
    rdfs:label "DerivedUnit" ;
    rdfs:subClassOf qudt:Unit ;
    skos:definition "Unit derived from base units (e.g., KiloM)" ;
    skos:exactMatch qudt:DerivedUnit ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

<https://dbpedia.org/ontology/CmykColor> a owl:Class ;
    rdfs:label "CmykColor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/cmykY> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/cmykM> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/cmykM> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/cmykK> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/cmykK> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty <https://dbpedia.org/ontology/cmykY> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty <https://dbpedia.org/ontology/cmykM> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/cmykC> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty <https://dbpedia.org/ontology/cmykC> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/cmykC> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty <https://dbpedia.org/ontology/cmykK> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/cmykY> ] ;
    skos:definition "CMYK color space coordinates (0-100)." ;
    skos:inScheme <https://dbpedia.org/ontology/> .

pokemon:Pokedex a owl:Class ;
    rdfs:label "Pokedex" ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "The Pokédex is an electronic device designed to catalog and provide information regarding the various species of Pokémon featured in the Pokémon video game, anime and manga series." ;
    skos:exactMatch pokemon:Pok%C3%A9dex ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Trainer a owl:Class ;
    rdfs:label "Trainer" ;
    rdfs:subClassOf foaf:Person ;
    skos:definition "A trainer is a person who is able to catch Pokémon." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:describesPokemon a owl:ObjectProperty ;
    rdfs:label "describesPokemon" ;
    rdfs:domain pokemon:PokedexEntry ;
    rdfs:range pokemon:Species ;
    skos:definition "A Pokémon that is described by this Pokédex entry." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:evolvesFrom a owl:ObjectProperty ;
    rdfs:label "evolvesFrom" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Species ;
    owl:inverseOf pokemon:evolvesTo ;
    skos:definition "This species evolves the other species." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:evolvesTo a owl:ObjectProperty ;
    rdfs:label "evolvesTo" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Species ;
    owl:inverseOf pokemon:evolvesFrom ;
    skos:definition "A Pokémon evolves to another Pokémon." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:locatedIn a owl:AsymmetricProperty,
        owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "locatedIn" ;
    rdfs:domain pokemon:Place ;
    rdfs:range pokemon:Place ;
    skos:definition "This place is located to some extent in another place." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

qudt:AbstractQuantityKind a owl:Class ;
    rdfs:label "AbstractQuantityKind" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:symbol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:symbol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:broader ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qudt:symbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:QuantityKind ;
            owl:onProperty qudt:broader ],
        qudt:Concept ;
    skos:definition "Abstract base for quantity kinds, constraining symbol and broader" ;
    skos:exactMatch qudt:AbstractQuantityKind ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:Quantifiable a owl:Class ;
    rdfs:label "Quantifiable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:relativeStandardUncertainty ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty qudt:standardUncertainty ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:standardUncertainty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:standardUncertainty ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:double ;
            owl:onProperty qudt:relativeStandardUncertainty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:hasUnit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:hasUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:relativeStandardUncertainty ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Unit ;
            owl:onProperty qudt:hasUnit ],
        qudt:Aspect ;
    skos:definition "Ascribes to some thing the capability of being measured, observed, or counted" ;
    skos:exactMatch qudt:Quantifiable ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:applicableSystem a owl:ObjectProperty ;
    rdfs:label "applicableSystem" ;
    rdfs:range qudt:SystemOfUnits ;
    skos:definition "Systems where this unit is applicable" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:applicableUnit a owl:ObjectProperty ;
    rdfs:label "applicableUnit" ;
    rdfs:range qudt:Unit ;
    skos:definition "Units applicable to a quantity kind" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:broader a owl:ObjectProperty ;
    rdfs:label "broader" ;
    rdfs:range qudt:QuantityKind ;
    skos:definition "Broader/parent quantity kind" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:hasBaseUnit a owl:ObjectProperty ;
    rdfs:label "hasBaseUnit" ;
    rdfs:range qudt:Unit ;
    skos:definition "Base units defined by this system" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:informativeReference a owl:DatatypeProperty ;
    rdfs:label "informativeReference" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Informative reference URL" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:isUnitOfSystem a owl:ObjectProperty ;
    rdfs:label "isUnitOfSystem" ;
    rdfs:range qudt:SystemOfUnits ;
    skos:definition "System of units this unit belongs to" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:isoNormativeReference a owl:DatatypeProperty ;
    rdfs:label "isoNormativeReference" ;
    rdfs:range xsd:anyURI ;
    skos:definition "ISO normative reference URI" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:normativeReference a owl:DatatypeProperty ;
    rdfs:label "normativeReference" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Normative reference URI" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:quantityValue a owl:ObjectProperty ;
    rdfs:label "quantityValue" ;
    rdfs:range qudt:QuantityValue ;
    skos:definition "The value component of a quantity" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

foaf:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty foaf:depiction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty foaf:depiction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty foaf:depiction ],
        owl:NamedIndividual ;
    skos:definition "A person is a human being" ;
    skos:exactMatch foaf:Person ;
    skos:inScheme foaf: .

<https://dbpedia.org/ontology/Color> a owl:Class ;
    rdfs:label "Color" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/thumbnail> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://dbpedia.org/ontology/wavelength> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://dbpedia.org/ontology/Connotation> ;
            owl:onProperty <https://dbpedia.org/ontology/connotation> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/wavelength> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/colorHexCode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://dbpedia.org/ontology/frequency> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/wavelength> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/frequency> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/thumbnail> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <https://dbpedia.org/ontology/thumbnail> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/frequency> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/connotation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://dbpedia.org/ontology/colorHexCode> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/colorHexCode> ],
        owl:Thing,
        <https://dbpedia.org/ontology/CmykColor> ;
    skos:definition "Color is the visual perceptual property corresponding in humans to the categories called red, yellow, blue and others." ;
    skos:exactMatch dbpedia:Colour ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/Connotation> a owl:Class ;
    rdfs:label "Connotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty owl:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty owl:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty owl:name ],
        owl:Thing ;
    skos:definition "Cultural or symbolic meaning associated with a color. Imported from DBpedia as generic owl:Thing resources." ;
    skos:exactMatch owl:Thing ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/connotation> a owl:ObjectProperty ;
    rdfs:label "connotation" ;
    rdfs:range <https://dbpedia.org/ontology/Connotation> ;
    skos:definition "Cultural or symbolic meanings associated with this color" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

pokemon:EggGroup a owl:Class ;
    rdfs:label "EggGroup" ;
    rdfs:subClassOf owl:NamedIndividual ;
    skos:definition "Egg group is a category that determines which Pokémon are able to interbreed. The concept was introduced in Generation II, along with breeding. Similar to types, a Pokémon may belong to either one or two egg groups." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Flavor a owl:Class ;
    rdfs:label "Flavor" ;
    rdfs:subClassOf owl:NamedIndividual ;
    skos:definition "Flavor is a special set of attributes that certain foods in the Pokémon world have. Most of the foods can have more than one flavor, and the flavor determines which Pokémon can eat them." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Habitat a owl:Class ;
    rdfs:label "Habitat" ;
    rdfs:subClassOf owl:NamedIndividual ;
    skos:definition "A habitat is a type of environment that certain Pokémon belong to." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Habitat_Cave a owl:NamedIndividual,
        pokemon:HabitatEnum ;
    rdfs:label "Cave" ;
    skos:definition "Pokemon found in caves, tunnels, and underground areas." .

pokemon:Habitat_Forest a owl:NamedIndividual,
        pokemon:HabitatEnum ;
    rdfs:label "Forest" ;
    skos:definition "Pokemon found in forests and wooded areas." .

pokemon:Habitat_Grassland a owl:NamedIndividual,
        pokemon:HabitatEnum ;
    rdfs:label "Grassland" ;
    skos:definition "Pokemon found in open grasslands, plains, and meadows." .

pokemon:Habitat_Mountain a owl:NamedIndividual,
        pokemon:HabitatEnum ;
    rdfs:label "Mountain" ;
    skos:definition "Pokemon found on mountains and rocky highlands." .

pokemon:Habitat_Rare a owl:NamedIndividual,
        pokemon:HabitatEnum ;
    rdfs:label "Rare" ;
    skos:definition "Pokemon that are rarely encountered and have no fixed habitat." .

pokemon:Habitat_RoughTerrain a owl:NamedIndividual,
        pokemon:HabitatEnum ;
    rdfs:label "Rough terrain" ;
    skos:definition "Pokemon found in harsh, rugged terrain such as deserts and wastelands." .

pokemon:Habitat_Sea a owl:NamedIndividual,
        pokemon:HabitatEnum ;
    rdfs:label "Sea" ;
    skos:definition "Pokemon found in oceans and deep water environments." .

pokemon:Habitat_Urban a owl:NamedIndividual,
        pokemon:HabitatEnum ;
    rdfs:label "Urban" ;
    skos:definition "Pokemon found in cities, towns, and human-built environments." .

pokemon:Habitat_WatersEdge a owl:NamedIndividual,
        pokemon:HabitatEnum ;
    rdfs:label "Water's edge" ;
    skos:definition "Pokemon found along shorelines, riverbanks, and wetlands." .

pokemon:Shape a owl:Class ;
    rdfs:label "Shape" ;
    rdfs:subClassOf owl:NamedIndividual ;
    skos:definition "Shapes are categories that certain Pokémon belong to, which determine which Pokémon they can breed with." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:featuresSpecies a owl:ObjectProperty ;
    rdfs:label "featuresSpecies" ;
    rdfs:range pokemon:Species ;
    skos:definition "['A Pokédex entry features a species']" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:foundIn a owl:ObjectProperty ;
    rdfs:label "foundIn" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Habitat ;
    skos:definition "A place is found in a location" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasFlavor a owl:ObjectProperty ;
    rdfs:label "hasFlavor" ;
    rdfs:domain pokemon:Food ;
    rdfs:range pokemon:Flavor ;
    skos:definition "A Pokémon has a flavor" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:inEggGroup a owl:ObjectProperty ;
    rdfs:label "inEggGroup" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:EggGroup ;
    skos:definition "Which egg group a species belongs to, controlling which Pokémon can breed together." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:isAbleToApply a owl:ObjectProperty ;
    rdfs:label "isAbleToApply" ;
    rdfs:range pokemon:Move ;
    skos:definition "Moves that a Pokémon can use in battle or in the overworld." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:mayHaveAbility a owl:ObjectProperty ;
    rdfs:label "mayHaveAbility" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Ability ;
    skos:definition "A Pokémon may have an ability" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:mayHaveHiddenAbility a owl:ObjectProperty ;
    rdfs:label "mayHaveHiddenAbility" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Ability ;
    skos:definition "A special ability only obtainable through specific encounters or events, not through normal gameplay." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

qudt:Aspect a owl:Class ;
    rdfs:label "Aspect" ;
    skos:definition "An abstract type class that defines properties that can be reused" ;
    skos:exactMatch qudt:Aspect ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:QuantityValue a owl:Class ;
    rdfs:label "QuantityValue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:numericValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Unit ;
            owl:onProperty qudt:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:double ;
            owl:onProperty qudt:numericValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:numericValue ],
        qudt:Concept ;
    skos:definition "Numeric value with unit" ;
    skos:exactMatch qudt:QuantityValue ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:abbreviation a owl:DatatypeProperty ;
    rdfs:label "abbreviation" ;
    rdfs:range xsd:string ;
    skos:definition "Short alphanumeric abbreviation for a unit" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:conversionMultiplier a owl:DatatypeProperty ;
    rdfs:label "conversionMultiplier" ;
    rdfs:range xsd:double ;
    skos:definition "Multiplier to convert to base unit" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:conversionOffset a owl:DatatypeProperty ;
    rdfs:label "conversionOffset" ;
    rdfs:range xsd:double ;
    skos:definition "Offset to convert to base unit" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:dbpediaMatch a owl:DatatypeProperty ;
    rdfs:label "dbpediaMatch" ;
    rdfs:range xsd:anyURI ;
    skos:definition "DBpedia URI for this entity" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:deprecated a owl:DatatypeProperty ;
    rdfs:label "deprecated" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether this entity is deprecated" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:dimensionExponentForAmountOfSubstance a owl:DatatypeProperty ;
    rdfs:label "dimensionExponentForAmountOfSubstance" ;
    rdfs:range xsd:integer ;
    skos:definition "Exponent for amount of substance dimension (N)" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:dimensionExponentForElectricCurrent a owl:DatatypeProperty ;
    rdfs:label "dimensionExponentForElectricCurrent" ;
    rdfs:range xsd:integer ;
    skos:definition "Exponent for electric current dimension (I)" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:dimensionExponentForLength a owl:DatatypeProperty ;
    rdfs:label "dimensionExponentForLength" ;
    rdfs:range xsd:integer ;
    skos:definition "Exponent for length dimension (L)" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:dimensionExponentForLuminousIntensity a owl:DatatypeProperty ;
    rdfs:label "dimensionExponentForLuminousIntensity" ;
    rdfs:range xsd:integer ;
    skos:definition "Exponent for luminous intensity dimension (J)" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:dimensionExponentForMass a owl:DatatypeProperty ;
    rdfs:label "dimensionExponentForMass" ;
    rdfs:range xsd:integer ;
    skos:definition "Exponent for mass dimension (M)" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:dimensionExponentForThermodynamicTemperature a owl:DatatypeProperty ;
    rdfs:label "dimensionExponentForThermodynamicTemperature" ;
    rdfs:range xsd:integer ;
    skos:definition "Exponent for temperature dimension (Θ)" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:dimensionExponentForTime a owl:DatatypeProperty ;
    rdfs:label "dimensionExponentForTime" ;
    rdfs:range xsd:integer ;
    skos:definition "Exponent for time dimension (T)" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:dimensionlessExponent a owl:DatatypeProperty ;
    rdfs:label "dimensionlessExponent" ;
    rdfs:range xsd:integer ;
    skos:definition "Dimensionless exponent" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:hasUnit a owl:ObjectProperty ;
    rdfs:label "hasUnit" ;
    rdfs:range qudt:Unit ;
    skos:definition "Unit associated with a quantifiable entity" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:numericValue a owl:DatatypeProperty ;
    rdfs:label "numericValue" ;
    rdfs:range xsd:double ;
    skos:definition "Numeric value of a quantity" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:plainTextDescription a owl:DatatypeProperty ;
    rdfs:label "plainTextDescription" ;
    rdfs:range xsd:string ;
    skos:definition "Plain text description" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:prefixMultiplier a owl:DatatypeProperty ;
    rdfs:label "prefixMultiplier" ;
    rdfs:range xsd:double ;
    skos:definition "Numeric multiplier for the prefix (e.g., 1000 for Kilo)" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:relativeStandardUncertainty a owl:DatatypeProperty ;
    rdfs:label "relativeStandardUncertainty" ;
    rdfs:range xsd:double ;
    skos:definition "Relative standard uncertainty of the measurement" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:scalingOf a owl:ObjectProperty ;
    rdfs:label "scalingOf" ;
    rdfs:range qudt:Unit ;
    skos:definition "Base unit this unit is a scaling of" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:standardUncertainty a owl:DatatypeProperty ;
    rdfs:label "standardUncertainty" ;
    rdfs:range xsd:decimal ;
    skos:definition "Standard uncertainty of the measurement" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:unit a owl:ObjectProperty ;
    rdfs:label "unit" ;
    rdfs:range qudt:Unit ;
    skos:definition "Unit of measurement" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:wikidataMatch a owl:DatatypeProperty ;
    rdfs:label "wikidataMatch" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Wikidata URI for this entity" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

owl:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "A description of the entity" ;
    skos:inScheme <http://www.w3.org/2002/07/owl> .

owl:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "A unique identifier" ;
    skos:inScheme <http://www.w3.org/2002/07/owl> .

<https://dbpedia.org/ontology/cmykC> a owl:DatatypeProperty ;
    rdfs:label "cmykC" ;
    rdfs:range xsd:integer ;
    skos:definition "Cyan component in CMYK color model (0-100)" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/cmykK> a owl:DatatypeProperty ;
    rdfs:label "cmykK" ;
    rdfs:range xsd:integer ;
    skos:definition "Black (K) component in CMYK color model (0-100)" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/cmykM> a owl:DatatypeProperty ;
    rdfs:label "cmykM" ;
    rdfs:range xsd:integer ;
    skos:definition "Magenta component in CMYK color model (0-100)" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/cmykY> a owl:DatatypeProperty ;
    rdfs:label "cmykY" ;
    rdfs:range xsd:integer ;
    skos:definition "Yellow component in CMYK color model (0-100)" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/colorHexCode> a owl:DatatypeProperty ;
    rdfs:label "colorHexCode" ;
    rdfs:range xsd:string ;
    skos:definition "Hexadecimal RGB color code (e.g., \"0000FF\" for blue)" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/frequency> a owl:DatatypeProperty ;
    rdfs:label "frequency" ;
    rdfs:range xsd:float ;
    skos:definition "The frequency of the color in Hz" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/thumbnail> a owl:DatatypeProperty ;
    rdfs:label "thumbnail" ;
    rdfs:range xsd:anyURI ;
    skos:definition "URL to a representative image of this color" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/wavelength> a owl:DatatypeProperty ;
    rdfs:label "wavelength" ;
    rdfs:range xsd:float ;
    skos:definition "The wavelength of the color in meters (e.g., 4.5e-07 for blue)" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

pokemon:firmness a owl:DatatypeProperty ;
    rdfs:label "firmness" ;
    rdfs:domain pokemon:Food ;
    rdfs:range xsd:integer ;
    skos:definition "How firm a berry or food item feels, affecting its use in Pokéblock or Poffin making." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasCatchRate a owl:DatatypeProperty ;
    rdfs:label "hasCatchRate" ;
    rdfs:domain pokemon:Species ;
    rdfs:range xsd:integer ;
    skos:definition "Determines how easy a Pokémon species is to catch, with higher values meaning easier capture." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasColor a owl:ObjectProperty ;
    rdfs:label "hasColor" ;
    rdfs:range <https://dbpedia.org/ontology/Color> ;
    skos:definition "A Pokémon has a color" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasGenus a owl:DatatypeProperty ;
    rdfs:label "hasGenus" ;
    rdfs:domain pokemon:Species ;
    rdfs:range xsd:string ;
    skos:definition "The species category label shown in the Pokédex, such as \"Seed Pokémon\" for Bulbasaur." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasHeight a owl:ObjectProperty ;
    rdfs:label "hasHeight" ;
    rdfs:domain pokemon:Species ;
    rdfs:range qudt:Quantity ;
    skos:definition "How tall a Pokémon species is, expressed as a quantity with unit." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasShape a owl:ObjectProperty ;
    rdfs:label "hasShape" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Shape ;
    skos:definition "The shape of a berry is a measure of how good it is for making a Potion." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasSize a owl:ObjectProperty ;
    rdfs:label "hasSize" ;
    rdfs:range qudt:Quantity ;
    skos:definition "The physical size of an entity, expressed as a quantity with unit." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasWeight a owl:ObjectProperty ;
    rdfs:label "hasWeight" ;
    rdfs:domain pokemon:Species ;
    rdfs:range qudt:Quantity ;
    skos:definition "How heavy a Pokémon species is, expressed as a quantity with unit." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:smoothness a owl:DatatypeProperty ;
    rdfs:label "smoothness" ;
    rdfs:domain pokemon:Food ;
    rdfs:range xsd:integer ;
    skos:definition "How smooth a berry or food item is, affecting its use in Pokéblock or Poffin making." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

qudt:Verifiable a owl:Class ;
    rdfs:label "Verifiable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:normativeReference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:dbpediaMatch ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:wikidataMatch ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty qudt:informativeReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty qudt:dbpediaMatch ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty qudt:isoNormativeReference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:dbpediaMatch ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty qudt:normativeReference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:wikidataMatch ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:informativeReference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:isoNormativeReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty qudt:wikidataMatch ],
        qudt:Aspect ;
    skos:definition "Holds properties that provide external knowledge and specifications of a given resource" ;
    skos:exactMatch qudt:Verifiable ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:exactMatch a owl:DatatypeProperty ;
    rdfs:label "exactMatch" ;
    skos:definition "Equivalent quantity kind or unit" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:hasQuantityKind a owl:ObjectProperty ;
    rdfs:label "hasQuantityKind" ;
    rdfs:range qudt:QuantityKind ;
    skos:definition "Associates a quantity with its kind (e.g., Height, Weight)" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

pokemon:Food a owl:Class ;
    rdfs:label "Food" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty pokemon:firmness ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:firmness ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:smoothness ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:firmness ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Flavor ;
            owl:onProperty pokemon:hasFlavor ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty pokemon:smoothness ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:smoothness ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasFlavor ],
        pokemon:Item ;
    skos:definition "Food items are consumable items in the Pokémon world that can have flavors, firmness, and smoothness attributes." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:MoveLearning a owl:Class ;
    rdfs:label "MoveLearning" ;
    skos:definition "A move learning is a way that a Pokémon can learn a move." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:PokedexEntry a owl:Class ;
    rdfs:label "PokedexEntry" ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "A Pokédex entry is a description of a Pokémon." ;
    skos:exactMatch pokemon:Pok%C3%A9dexEntry ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Type a owl:Class ;
    rdfs:label "Type" ;
    rdfs:subClassOf owl:NamedIndividual ;
    skos:definition "All Pokémon creatures and their moves are assigned certain types. Each type has several strengths and weaknesses in both attack and defense." ;
    skos:exactMatch pokemon:Type ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:effectDescription a owl:DatatypeProperty ;
    rdfs:label "effectDescription" ;
    rdfs:range xsd:string ;
    skos:definition "A description of the effect of the entity" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasType a owl:ObjectProperty ;
    rdfs:label "hasType" ;
    rdfs:range pokemon:Type ;
    skos:definition "A Pokémon has a type" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

qudt:Prefix a owl:Class ;
    rdfs:label "Prefix" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:double ;
            owl:onProperty qudt:prefixMultiplier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:exactMatch ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:symbol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:prefixMultiplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qudt:symbol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:symbol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:ucumCode ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:ucumCode ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:prefixMultiplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qudt:ucumCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qudt:exactMatch ],
        qudt:Concept,
        qudt:Verifiable ;
    skos:definition "Unit prefix (e.g., Kilo, Milli)" ;
    skos:exactMatch qudt:Prefix ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:SystemOfUnits a owl:Class ;
    rdfs:label "SystemOfUnits" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:prefix ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Unit ;
            owl:onProperty qudt:hasBaseUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:hasBaseUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Prefix ;
            owl:onProperty qudt:prefix ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:prefix ],
        qudt:Concept ;
    skos:definition "A coherent system of units (e.g., SI, CGS)" ;
    skos:exactMatch qudt:SystemOfUnits ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

pokemon:Ability a owl:Class ;
    rdfs:label "Ability" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:effectDescription ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:effectDescription ],
        owl:Thing ;
    skos:definition "Abilities were introduced in Generation III as an all new game mechanic. Each and every Pokémon has an ability, and can only have one at a time. Some abilities are exclusive to certain Pokémon and Evolution lines, while others are known by many Pokémon." ;
    skos:exactMatch pokemon:Ability ;
    skos:inScheme <https://pokemonkg.org/ontology> .

qudt:QuantityKind a owl:Class ;
    rdfs:label "QuantityKind" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:latexSymbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:QuantityKindDimensionVector ;
            owl:onProperty qudt:hasDimensionVector ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:hasDimensionVector ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:hasDimensionVector ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:latexSymbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qudt:exactMatch ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:exactMatch ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:applicableUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qudt:latexSymbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Unit ;
            owl:onProperty qudt:applicableUnit ],
        qudt:AbstractQuantityKind,
        qudt:Verifiable ;
    skos:definition "Kind of quantity (e.g., Length, Mass, Height, Weight)" ;
    skos:exactMatch qudt:QuantityKind ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:hasDimensionVector a owl:ObjectProperty ;
    rdfs:label "hasDimensionVector" ;
    rdfs:range qudt:QuantityKindDimensionVector ;
    skos:definition "Dimension vector for a unit or quantity kind" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:prefix a owl:ObjectProperty ;
    rdfs:label "prefix" ;
    rdfs:range qudt:Prefix ;
    skos:definition "Prefix for a unit (e.g., Kilo, Milli)" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:ucumCode a owl:DatatypeProperty ;
    rdfs:label "ucumCode" ;
    rdfs:range xsd:string ;
    skos:definition "UCUM code for the unit" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

foaf:depiction a owl:DatatypeProperty ;
    rdfs:label "depiction" ;
    rdfs:range xsd:string ;
    skos:definition "A depiction of the person" ;
    skos:inScheme foaf: .

qudt:Quantity a owl:Class ;
    rdfs:label "Quantity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:hasQuantityKind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:quantityValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:QuantityKind ;
            owl:onProperty qudt:hasQuantityKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:QuantityValue ;
            owl:onProperty qudt:quantityValue ],
        qudt:Concept,
        qudt:Quantifiable ;
    skos:definition "A measured quantity with kind and value" ;
    skos:exactMatch qudt:Quantity ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

pokemon:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "An item is an object in the Pokémon games which the player can pick up, keep in their Bag, and use in some manner. They have various uses, including healing, powering up, helping one to catch Pokémon, or to access a new area." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Place a owl:Class ;
    rdfs:label "Place" ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "Entities that have a somewhat fixed, physical extension." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

qudt:Concept a owl:Class ;
    rdfs:label "Concept" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qudt:plainTextDescription ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qudt:abbreviation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:abbreviation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:deprecated ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty qudt:deprecated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:plainTextDescription ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:deprecated ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:plainTextDescription ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:abbreviation ],
        owl:Thing ;
    skos:definition "The root class for all QUDT concepts" ;
    skos:exactMatch qudt:Concept ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:QuantityKindDimensionVector a owl:Class ;
    rdfs:label "QuantityKindDimensionVector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qudt:latexSymbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty qudt:dimensionExponentForAmountOfSubstance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:dimensionExponentForTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:dimensionExponentForElectricCurrent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:dimensionExponentForLuminousIntensity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:dimensionExponentForMass ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:dimensionExponentForElectricCurrent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty qudt:dimensionExponentForLength ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:latexSymbol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:dimensionExponentForLuminousIntensity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty qudt:dimensionExponentForElectricCurrent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty qudt:dimensionExponentForMass ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:latexSymbol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:dimensionExponentForLength ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:dimensionlessExponent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:dimensionlessExponent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty qudt:dimensionExponentForThermodynamicTemperature ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty qudt:dimensionExponentForTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty qudt:dimensionlessExponent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:dimensionExponentForMass ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:dimensionExponentForTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:dimensionExponentForAmountOfSubstance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:dimensionExponentForThermodynamicTemperature ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:dimensionExponentForThermodynamicTemperature ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:dimensionExponentForLength ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty qudt:dimensionExponentForLuminousIntensity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:dimensionExponentForAmountOfSubstance ],
        qudt:Concept ;
    skos:definition "Dimension vector expressing quantity in base dimensions" ;
    skos:exactMatch qudt:QuantityKindDimensionVector ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:latexSymbol a owl:DatatypeProperty ;
    rdfs:label "latexSymbol" ;
    rdfs:range xsd:string ;
    skos:definition "LaTeX representation of symbol" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

qudt:symbol a owl:DatatypeProperty ;
    rdfs:label "symbol" ;
    rdfs:range xsd:string ;
    skos:definition "Symbol for a unit (e.g., \"m\" for meter)" ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

owl:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable label for the entity" ;
    skos:inScheme <http://www.w3.org/2002/07/owl> .

pokemon:HabitatEnum a owl:Class ;
    rdfs:label "HabitatEnum" ;
    owl:oneOf ( pokemon:Habitat_Cave pokemon:Habitat_Forest pokemon:Habitat_Grassland pokemon:Habitat_Mountain pokemon:Habitat_Rare pokemon:Habitat_RoughTerrain pokemon:Habitat_Sea pokemon:Habitat_Urban pokemon:Habitat_WatersEdge ) ;
    skos:inScheme <https://pokemonkg.org/ontology> ;
    linkml:permissible_values pokemon:Habitat_Cave,
        pokemon:Habitat_Forest,
        pokemon:Habitat_Grassland,
        pokemon:Habitat_Mountain,
        pokemon:Habitat_Rare,
        pokemon:Habitat_RoughTerrain,
        pokemon:Habitat_Sea,
        pokemon:Habitat_Urban,
        pokemon:Habitat_WatersEdge .

pokemon:Move a owl:Class ;
    rdfs:label "Move" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Type ;
            owl:onProperty pokemon:hasType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:effectDescription ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:effectDescription ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasType ],
        owl:Thing ;
    skos:definition "A move is a special ability of a Pokémon." ;
    skos:exactMatch pokemon:Move ;
    skos:inScheme <https://pokemonkg.org/ontology> .

qudt:Unit a owl:Class ;
    rdfs:label "Unit" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom qudt:QuantityKindDimensionVector ;
            owl:onProperty qudt:hasDimensionVector ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Unit ;
            owl:onProperty qudt:scalingOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:hasQuantityKind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:symbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qudt:symbol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:isUnitOfSystem ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:ucumCode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:conversionOffset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:hasDimensionVector ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:ucumCode ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:scalingOf ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:conversionMultiplier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:hasDimensionVector ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:conversionOffset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:double ;
            owl:onProperty qudt:conversionOffset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qudt:ucumCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:double ;
            owl:onProperty qudt:conversionMultiplier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:latexSymbol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:scalingOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:SystemOfUnits ;
            owl:onProperty qudt:applicableSystem ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:applicableSystem ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:QuantityKind ;
            owl:onProperty qudt:hasQuantityKind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:latexSymbol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:prefix ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:conversionMultiplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Prefix ;
            owl:onProperty qudt:prefix ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty qudt:prefix ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty qudt:latexSymbol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty qudt:symbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:SystemOfUnits ;
            owl:onProperty qudt:isUnitOfSystem ],
        qudt:Concept,
        qudt:Verifiable ;
    skos:definition "Unit of measurement" ;
    skos:exactMatch qudt:Unit ;
    skos:inScheme <https://pokemonkg.org/schema/qudt> .

owl:Thing a owl:Class ;
    rdfs:label "Thing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty owl:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty owl:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty owl:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty owl:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty owl:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty owl:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty owl:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty owl:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty owl:name ] ;
    skos:definition "An rdfs:Resource that defines name and description" ;
    skos:exactMatch owl:Thing ;
    skos:inScheme <http://www.w3.org/2002/07/owl> .

owl:NamedIndividual a owl:Class ;
    rdfs:label "NamedIndividual" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty owl:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty owl:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty owl:name ],
        owl:Thing ;
    skos:definition "A Thing that requires a name" ;
    skos:exactMatch owl:NamedIndividual ;
    skos:inScheme <http://www.w3.org/2002/07/owl> .

pokemon:Species a owl:Class ;
    rdfs:label "Species" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty foaf:depiction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:hasGenus ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:hasColor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasCatchRate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:inEggGroup ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:mayHaveAbility ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty pokemon:hasCatchRate ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Quantity ;
            owl:onProperty pokemon:hasHeight ],
        [ a owl:Restriction ;
