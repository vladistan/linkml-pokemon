# metamodel_version: 1.7.0
BASE <https://pokemonkg.org/ontology#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX linkml: <https://w3id.org/linkml/>
PREFIX dbpedia: <http://dbpedia.org/ontology/>
PREFIX qudt: <http://qudt.org/schema/qudt/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<Ability> CLOSED {
    (  $<Ability_tes> (  &owl:Thing_tes ;
          rdf:type [ owl:Thing ] ? ;
          <effectDescription> @linkml:String *
       ) ;
       rdf:type [ <Ability> ]
    )
}

<BattleItem> CLOSED {
    (  $<BattleItem_tes> (  &<Item_tes> ;
          rdf:type [ <Item> ] ?
       ) ;
       rdf:type [ <BattleItem> ]
    )
}

<Berry> CLOSED {
    (  $<Berry_tes> (  &<Food_tes> ;
          rdf:type [ <Food> ] ? ;
          <hasSize> @linkml:String ?
       ) ;
       rdf:type [ <Berry> ]
    )
}

<https://dbpedia.org/ontology/Colour> CLOSED {
    (  $<https://dbpedia.org/ontology/Colour_tes> (  &owl:Thing_tes ;
          rdf:type [ owl:Thing ] ? ;
          dbpedia:cmykCoordinateBlack @linkml:Float ? ;
          dbpedia:cmykCoordinateCyanic @linkml:Float ? ;
          dbpedia:cmykCoordinateMagenta @linkml:Float ? ;
          dbpedia:cmykCoordinateYellow @linkml:Float ? ;
          dbpedia:hsvCoordinateHue @linkml:Float ? ;
          dbpedia:hsvCoordinateSaturation @linkml:Float ? ;
          dbpedia:hsvCoordinateLightness @linkml:Float ? ;
          dbpedia:rgbCoordinateRed @linkml:Integer ? ;
          dbpedia:rgbCoordinateGreen @linkml:Integer ? ;
          dbpedia:rgbCoordinateBlue @linkml:Integer ? ;
          dbpedia:wavelength @linkml:Float ?
       ) ;
       rdf:type [ dbpedia:Colour ]
    )
}

<EggGroup> CLOSED {
    (  $<EggGroup_tes> (  &owl:NamedIndividual_tes ;
          rdf:type [ owl:NamedIndividual ] ?
       ) ;
       rdf:type [ <EggGroup> ]
    )
}

<Flavor> CLOSED {
    (  $<Flavor_tes> (  &owl:NamedIndividual_tes ;
          rdf:type [ owl:NamedIndividual ] ?
       ) ;
       rdf:type [ <Flavor> ]
    )
}

<Food>  (
    CLOSED {
       (  $<Food_tes> (  &<Item_tes> ;
             rdf:type [ <Item> ] ? ;
             <hasFlavor> @<Flavor> * ;
             <firmness> @linkml:Integer ? ;
             <smoothness> @linkml:Integer ?
          ) ;
          rdf:type [ <Food> ]
       )
    } OR @<Berry>
)

<Game> CLOSED {
    (  $<Game_tes> (  &owl:Thing_tes ;
          rdf:type [ owl:Thing ] ?
       ) ;
       rdf:type [ <Game> ]
    )
}

<Generation> CLOSED {
    (  $<Generation_tes> (  &owl:Thing_tes ;
          rdf:type [ owl:Thing ] ? ;
          <featuresSpecies> @<Species> *
       ) ;
       rdf:type [ <Generation> ]
    )
}

<Gym> CLOSED {
    (  $<Gym_tes> (  &<Place_tes> ;
          rdf:type [ <Place> ] ?
       ) ;
       rdf:type [ <Gym> ]
    )
}

<GymLeader> CLOSED {
    (  $<GymLeader_tes> (  &<Trainer_tes> ;
          rdf:type [ <Trainer> ] ?
       ) ;
       rdf:type [ <GymLeader> ]
    )
}

<Habitat> CLOSED {
    (  $<Habitat_tes> (  &owl:NamedIndividual_tes ;
          rdf:type [ owl:NamedIndividual ] ?
       ) ;
       rdf:type [ <Habitat> ]
    )
}

<HM> CLOSED {
    (  $<HM_tes> (  &<Item_tes> ;
          rdf:type [ <Item> ] ?
       ) ;
       rdf:type [ <HM> ]
    )
}

<HoldItem> CLOSED {
    (  $<HoldItem_tes> (  &<Item_tes> ;
          rdf:type [ <Item> ] ?
       ) ;
       rdf:type [ <HoldItem> ]
    )
}

<Item>  (
    CLOSED {
       (  $<Item_tes> (  &owl:Thing_tes ;
             rdf:type [ owl:Thing ] ?
          ) ;
          rdf:type [ <Item> ]
       )
    } OR @<BattleItem> OR @<Food> OR @<HM> OR @<HoldItem> OR @<Medicine> OR @<Pokeball> OR @<TM>
)

<LearningByLevelingUp> CLOSED {
    (  $<LearningByLevelingUp_tes> (  &<MoveLearning_tes> ;
          rdf:type [ <MoveLearning> ] ?
       ) ;
       rdf:type [ <LearningByLevelingUp> ] ?
    )
}

<LearningThroughBreeding> CLOSED {
    (  $<LearningThroughBreeding_tes> (  &<MoveLearning_tes> ;
          rdf:type [ <MoveLearning> ] ?
       ) ;
       rdf:type [ <LearningThroughBreeding> ] ?
    )
}

<Medicine> CLOSED {
    (  $<Medicine_tes> (  &<Item_tes> ;
          rdf:type [ <Item> ] ?
       ) ;
       rdf:type [ <Medicine> ]
    )
}

<Move>  (
    CLOSED {
       (  $<Move_tes> (  &owl:Thing_tes ;
             rdf:type [ owl:Thing ] ? ;
             <effectDescription> @linkml:String * ;
             <hasType> @<Type> *
          ) ;
          rdf:type [ <Move> ]
       )
    } OR @<PhysicalMove> OR @<SpecialMove> OR @<StatusMove>
)

<MoveLearning>  (
    CLOSED {
       (  $<MoveLearning_tes> rdf:type . * ;
          rdf:type [ <MoveLearning> ] ?
       )
    } OR @<LearningByLevelingUp> OR @<LearningThroughBreeding>
)

owl:NamedIndividual  (
    @<EggGroup> OR @<Flavor> OR @<Habitat> OR @foaf:Person OR @<Shape> OR @<Species> OR @<Type>
)

owl:NamedIndividual_struct {
    (  $owl:NamedIndividual_tes (  &owl:Thing_tes ;
          rdf:type [ owl:Thing ] ? ;
          rdfs:label @linkml:String
       ) ;
       rdf:type [ owl:NamedIndividual ]
    )
}

foaf:Person  (
    CLOSED {
       (  $foaf:Person_tes (  &owl:NamedIndividual_tes ;
             rdf:type [ owl:NamedIndividual ] ? ;
             foaf:depiction @linkml:String ?
          ) ;
          rdf:type [ foaf:Person ]
       )
    } OR @<Trainer>
)

<PhysicalMove> CLOSED {
    (  $<PhysicalMove_tes> (  &<Move_tes> ;
          rdf:type [ <Move> ] ?
       ) ;
       rdf:type [ <PhysicalMove> ]
    )
}

<Place>  (
    @<Gym> OR @<Region> OR @<Town>
)

<Place_struct> {
    (  $<Place_tes> (  &owl:Thing_tes ;
          rdf:type [ owl:Thing ] ?
       ) ;
       rdf:type [ <Place> ]
    )
}

<Pokeball> CLOSED {
    (  $<Pokeball_tes> (  &<Item_tes> ;
          rdf:type [ <Item> ] ?
       ) ;
       rdf:type [ <Pokeball> ]
    )
}

<Pokedex> CLOSED {
    (  $<Pokedex_tes> (  &owl:Thing_tes ;
          rdf:type [ owl:Thing ] ?
       ) ;
       rdf:type [ <Pokedex> ]
    )
}

<PokedexEntry> CLOSED {
    (  $<PokedexEntry_tes> (  &owl:Thing_tes ;
          rdf:type [ owl:Thing ] ?
       ) ;
       rdf:type [ <PokedexEntry> ]
    )
}

<Pokemon> CLOSED {
    (  $<Pokemon_tes> rdf:type . * ;
       rdf:type [ <Pokemon> ] ?
    )
}

<http://qudt.org/2.1/vocab/unit/Quantity> CLOSED {
    (  $<http://qudt.org/2.1/vocab/unit/Quantity_tes> (  &owl:Thing_tes ;
          rdf:type [ owl:Thing ] ? ;
          qudt:hasUnit @<http://qudt.org/2.1/vocab/unit/Unit> * ;
          qudt:hasQuantityKind @<http://qudt.org/2.1/vocab/unit/QuantityKind> ? ;
          qudt:quantityValue @linkml:String ?
       ) ;
       rdf:type [ qudt:Quantity ]
    )
}

<http://qudt.org/2.1/vocab/unit/QuantityKind> CLOSED {
    (  $<http://qudt.org/2.1/vocab/unit/QuantityKind_tes> rdf:type . * ;
       rdf:type [ qudt:QuantityKind ] ?
    )
}

<Region> CLOSED {
    (  $<Region_tes> (  &<Place_tes> ;
          rdf:type [ <Place> ] ?
       ) ;
       rdf:type [ <Region> ]
    )
}

<Shape> CLOSED {
    (  $<Shape_tes> (  &owl:NamedIndividual_tes ;
          rdf:type [ owl:NamedIndividual ] ?
       ) ;
       rdf:type [ <Shape> ]
    )
}

<SpecialMove> CLOSED {
    (  $<SpecialMove_tes> (  &<Move_tes> ;
          rdf:type [ <Move> ] ?
       ) ;
       rdf:type [ <SpecialMove> ]
    )
}

<Species> CLOSED {
    (  $<Species_tes> (  &owl:NamedIndividual_tes ;
          rdf:type [ owl:NamedIndividual ] ? ;
          <hasColour> @<https://dbpedia.org/ontology/Colour> ? ;
          <mayHaveHiddenAbility> @<Ability> * ;
          <mayHaveAbility> @<Ability> * ;
          <isAbleToApply> @<Move> * ;
          <hasHeight> @<http://qudt.org/2.1/vocab/unit/Quantity> ? ;
          <hasWeight> @<http://qudt.org/2.1/vocab/unit/Quantity> ? ;
          foaf:depiction @linkml:String ? ;
          <inEggGroup> @<EggGroup> * ;
          <hasType> @<Type> * ;
          <hasShape> @<Shape> ? ;
          <hasGenus> @linkml:String ? ;
          <hasCatchRate> @linkml:Integer ? ;
          <foundIn> @<Habitat> *
       ) ;
       rdf:type [ <Species> ]
    )
}

<StatusMove> CLOSED {
    (  $<StatusMove_tes> (  &<Move_tes> ;
          rdf:type [ <Move> ] ?
       ) ;
       rdf:type [ <StatusMove> ]
    )
}

owl:Thing  (
    @<Ability> OR @<https://dbpedia.org/ontology/Colour> OR @<Game> OR @<Generation> OR @<Item> OR @<Move> OR @owl:NamedIndividual
    OR @<Place> OR @<Pokedex> OR @<PokedexEntry> OR @<http://qudt.org/2.1/vocab/unit/Quantity> OR
    @<http://qudt.org/2.1/vocab/unit/Unit>
)

owl:Thing_struct {
    (  $owl:Thing_tes (  rdfs:label @linkml:String ? ;
          rdfs:comment @linkml:String ?
       ) ;
       rdf:type [ owl:Thing ]
    )
}

<TM> CLOSED {
    (  $<TM_tes> (  &<Item_tes> ;
          rdf:type [ <Item> ] ? ;
          &<MoveLearning_tes> ;
          rdf:type [ <MoveLearning> ] ?
       ) ;
       rdf:type [ <TM> ]
    )
}

<Town> CLOSED {
    (  $<Town_tes> (  &<Place_tes> ;
          rdf:type [ <Place> ] ?
       ) ;
       rdf:type [ <Town> ]
    )
}

<Trainer>  (
    CLOSED {
       (  $<Trainer_tes> (  &foaf:Person_tes ;
             rdf:type [ foaf:Person ] ?
          ) ;
          rdf:type [ <Trainer> ]
       )
    } OR @<GymLeader>
)

<Type> CLOSED {
    (  $<Type_tes> (  &owl:NamedIndividual_tes ;
          rdf:type [ owl:NamedIndividual ] ?
       ) ;
       rdf:type [ <Type> ]
    )
}

<http://qudt.org/2.1/vocab/unit/Unit> CLOSED {
    (  $<http://qudt.org/2.1/vocab/unit/Unit_tes> (  &owl:Thing_tes ;
          rdf:type [ owl:Thing ] ?
       ) ;
       rdf:type [ qudt:Unit ]
    )
}
