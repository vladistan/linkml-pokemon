            owl:onProperty <https://dbpedia.org/ontology/value> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/red> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://dbpedia.org/ontology/yellow> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/red> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://dbpedia.org/ontology/hue> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://dbpedia.org/ontology/black> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://dbpedia.org/ontology/magenta> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/black> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/black> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/yellow> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/wavelength> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/hue> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://dbpedia.org/ontology/cyanic> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/wavelength> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/cyanic> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://dbpedia.org/ontology/saturation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty <https://dbpedia.org/ontology/green> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/blue> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://dbpedia.org/ontology/wavelength> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/green> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/magenta> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/blue> ],
        owl:Thing ;
    skos:definition "Color or colour is the visual perceptual property corresponding in humans to the categories called red, yellow, blue and others." ;
    skos:exactMatch dbpedia:Colour ;
    skos:inScheme <https://dbpedia.org/ontology/> .

pokemon:EggGroup a owl:Class ;
    rdfs:label "EggGroup" ;
    rdfs:comment "Egg group is a category that determines which Pokemon are able to interbreed. The concept was introduced in Generation II, along with breeding. Similar to types, a Pokémon may belong to either one or two egg groups." ;
    rdfs:subClassOf owl:NamedIndividual ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Flavor a owl:Class ;
    rdfs:label "Flavor" ;
    rdfs:comment "Flavor is a special set of attributes that certain foods in the Pokémon world have. Most of the foods can have more than one flavor, and the flavor determines which Pokemon can eat them." ;
    rdfs:subClassOf owl:NamedIndividual ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Habitat a owl:Class ;
    rdfs:label "Habitat" ;
    rdfs:subClassOf owl:NamedIndividual ;
    skos:definition "A habitat is a type of environment that certain Pokemon belong to." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Habitat_Cave a owl:NamedIndividual,
        pokemon:HabitatEnum ;
    rdfs:label "Cave" .

pokemon:Habitat_Forest a owl:NamedIndividual,
        pokemon:HabitatEnum ;
    rdfs:label "Forest" .

pokemon:Habitat_Grassland a owl:NamedIndividual,
        pokemon:HabitatEnum ;
    rdfs:label "Grassland" .

pokemon:Shape a owl:Class ;
    rdfs:label "Shape" ;
    rdfs:subClassOf owl:NamedIndividual ;
    skos:definition "Shapes are categories that certain Pokemon belong to, which determine which Pokemon they can breed with." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:featuresSpecies a owl:ObjectProperty ;
    rdfs:label "featuresSpecies" ;
    rdfs:range pokemon:Species ;
    skos:definition "['A Pokedex entry features a species']" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:foundIn a owl:ObjectProperty ;
    rdfs:label "foundIn" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Habitat ;
    skos:definition "A place is found in a location" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasFlavor a owl:ObjectProperty ;
    rdfs:label "hasFlavor" ;
    rdfs:domain pokemon:Food ;
    rdfs:range pokemon:Flavor ;
    skos:definition "A Pokemon has a flavor" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:inEggGroup a owl:ObjectProperty ;
    rdfs:label "inEggGroup" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:EggGroup ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:isAbleToApply a owl:ObjectProperty ;
    rdfs:label "isAbleToApply" ;
    rdfs:range pokemon:Move ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:mayHaveAbility a owl:ObjectProperty ;
    rdfs:label "mayHaveAbility" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Ability ;
    skos:definition "A Pokemon may have an ability" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:mayHaveHiddenAbility a owl:ObjectProperty ;
    rdfs:label "mayHaveHiddenAbility" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Ability ;
    skos:inScheme <https://pokemonkg.org/ontology> .

qudt:DataEncoding a owl:Class ;
    rdfs:label "DataEncoding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:bitOrder ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:byteOrder ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:encoding ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:EndianType ;
            owl:onProperty pokemon:bitOrder ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Encoding ;
            owl:onProperty pokemon:encoding ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty pokemon:byteOrder ],
        qudt:Aspect ;
    skos:definition "<p><em>Data Encoding</em> expresses the properties that specify how data is represented at the bit and byte level. These properties are applicable to describing raw data.</p>" ;
    skos:exactMatch qudt:DataEncoding ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> ;
    skos:note "<p><em>Data Encoding</em> expresses the properties that specify how data is represented at the bit and byte level. These properties are applicable to describing raw data.</p>^^rdf:HTML" .

qudt:Enumeration a owl:Class ;
    rdfs:label "Enumeration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:abbreviation ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:EnumeratedValue ;
            owl:onProperty pokemon:default ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pokemon:element ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:EnumeratedValue ;
            owl:onProperty pokemon:element ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:default ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:abbreviation ],
        qudt:Concept ;
    skos:definition """<p>An enumeration is a set of literals from which a single value is selected. Each literal can have a tag as an integer within a standard encoding appropriate to the range of integer values. Consistency of enumeration types will allow them, and the enumerated values, to be referred to unambiguously either through symbolic name or encoding. Enumerated values are also controlled vocabularies and as such need to be standardized. Without this consistency enumeration literals can be stated differently and result in  data conflicts and misinterpretations.</p>

<p>The tags are a set of positive whole numbers, not necessarily contiguous and having no numerical significance, each corresponding to the associated literal identifier. An order attribute can also be given on the enumeration elements. An enumeration can itself be a member of an enumeration. This allows enumerations to be enumerated in a selection. Enumerations are also subclasses of <em>Scalar Datatype</em>. This allows them to be used as the reference of a datatype specification.</p>""" ;
    skos:exactMatch qudt:Enumeration ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> ;
    skos:note """<p>An enumeration is a set of literals from which a single value is selected. Each literal can have a tag as an integer within a standard encoding appropriate to the range of integer values. Consistency of enumeration types will allow them, and the enumerated values, to be referred to unambiguously either through symbolic name or encoding. Enumerated values are also controlled vocabularies and as such need to be standardized. Without this consistency enumeration literals can be stated differently and result in  data conflicts and misinterpretations.</p>

<p>The tags are a set of positive whole numbers, not necessarily contiguous and having no numerical significance, each corresponding to the associated literal identifier. An order attribute can also be given on the enumeration elements. An enumeration can itself be a member of an enumeration. This allows enumerations to be enumerated in a selection. Enumerations are also subclasses of <em>Scalar Datatype</em>. This allows them to be used as the reference of a datatype specification.</p>^^rdf:HTML""" .

qudt:PhysicalConstant a owl:Class ;
    rdfs:label "PhysicalConstant" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:exactConstant ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:latexDefinition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:altSymbol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasDimensionVector ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:latexSymbol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:applicableSystem ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:symbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:symbol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:exactMatch ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:PhysicalConstant ;
            owl:onProperty pokemon:exactMatch ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:applicableUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:mathMLdefinition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:latexSymbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:isoNormativeReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:SystemOfUnits ;
            owl:onProperty pokemon:applicableSystem ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:normativeReference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:latexDefinition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:ucumCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:QuantityKindDimensionVector ;
            owl:onProperty pokemon:hasDimensionVector ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:altSymbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:normativeReference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:ucumCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Unit ;
            owl:onProperty pokemon:applicableUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:isoNormativeReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty pokemon:exactConstant ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:mathMLdefinition ],
        qudt:Quantity ;
    skos:definition "A physical constant is a physical quantity that is generally believed to be both universal in nature and constant in time. It can be contrasted with a mathematical constant, which is a fixed numerical value but does not directly involve any physical measurement. There are many physical constants in science, some of the most widely recognized being the speed of light in vacuum c, Newton's gravitational constant G, Planck's constant h, the electric permittivity of free space ε0, and the elementary charge e. Physical constants can take many dimensional forms, or may be dimensionless depending on the system of quantities and units used." ;
    skos:exactMatch qudt:PhysicalConstant ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> ;
    skos:note "A physical constant is a physical quantity that is generally believed to be both universal in nature and constant in time. It can be contrasted with a mathematical constant, which is a fixed numerical value but does not directly involve any physical measurement. There are many physical constants in science, some of the most widely recognized being the speed of light in vacuum c, Newton's gravitational constant G, Planck's constant h, the electric permittivity of free space ε0, and the elementary charge e. Physical constants can take many dimensional forms, or may be dimensionless depending on the system of quantities and units used.^^rdf:HTML" .

qudt:Quantifiable a owl:Class ;
    rdfs:label "Quantifiable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom qudt:DataEncoding ;
            owl:onProperty pokemon:dataEncoding ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Datatype ;
            owl:onProperty pokemon:datatype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:dataEncoding ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:qudt_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:relativeStandardUncertainty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:valueSN ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty pokemon:standardUncertainty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:datatype ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Unit ;
            owl:onProperty pokemon:hasUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:standardUncertainty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:standardUncertaintySN ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:double ;
            owl:onProperty pokemon:relativeStandardUncertainty ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:valueSN ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:double ;
            owl:onProperty pokemon:standardUncertaintySN ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:qudt_value ],
        qudt:Aspect ;
    skos:definition "<p><em>Quantifiable</em> ascribes to some thing the capability of being measured, observed, or counted.</p>" ;
    skos:exactMatch qudt:Quantifiable ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> ;
    skos:note "<p><em>Quantifiable</em> ascribes to some thing the capability of being measured, observed, or counted.</p>^^rdf:HTML" .

qudt:QuantityValue a owl:Class ;
    rdfs:label "QuantityValue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty pokemon:hasUnit ],
        qudt:Concept,
        qudt:Quantifiable ;
    skos:definition "A <i>Quantity Value</i> expresses the magnitude and kind of a quantity and is given by the product of a numerical value <code>n</code> and a unit of measure <code>U</code>. The number multiplying the unit is referred to as the numerical value of the quantity expressed in that unit. Refer to <a href=\"http://physics.nist.gov/Pubs/SP811/sec07.html\">NIST SP 811 section 7</a> for more on quantity values." ;
    skos:exactMatch qudt:QuantityValue ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> ;
    skos:note "A <i>Quantity Value</i> expresses the magnitude and kind of a quantity and is given by the product of a numerical value <code>n</code> and a unit of measure <code>U</code>. The number multiplying the unit is referred to as the numerical value of the quantity expressed in that unit. Refer to <a href=\\\"http://physics.nist.gov/Pubs/SP811/sec07.html\\\">NIST SP 811 section 7</a> for more on quantity values.^^rdf:HTML" .

qudt:SystemOfQuantityKinds a owl:Class ;
    rdfs:label "SystemOfQuantityKinds" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom qudt:QuantityKind ;
            owl:onProperty pokemon:systemDerivedQuantityKind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasQuantityKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Enumeration ;
            owl:onProperty pokemon:baseDimensionEnumeration ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:systemDerivedQuantityKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:SystemOfUnits ;
            owl:onProperty pokemon:hasUnitSystem ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasBaseQuantityKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:QuantityKind ;
            owl:onProperty pokemon:hasQuantityKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:QuantityKind ;
            owl:onProperty pokemon:hasBaseQuantityKind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasUnitSystem ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:baseDimensionEnumeration ],
        qudt:Concept ;
    skos:definition "A system of quantity kinds is a set of one or more quantity kinds together with a set of zero or more algebraic equations that define relationships between quantity kinds in the set. In the physical sciences, the equations relating quantity kinds are typically physical laws and definitional relations, and constants of proportionality. Examples include Newton’s First Law of Motion, Coulomb’s Law, and the definition of velocity as the instantaneous change in position.  In almost all cases, the system identifies a subset of base quantity kinds. The base set is chosen so that all other quantity kinds of interest can be derived from the base quantity kinds and the algebraic equations. If the unit system is explicitly associated with a quantity kind system, then the unit system must define at least one unit for each quantity kind.  From a scientific point of view, the division of quantities into base quantities and derived quantities is a matter of convention." ;
    skos:exactMatch qudt:SystemOfQuantityKinds ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> ;
    skos:note "A system of quantity kinds is a set of one or more quantity kinds together with a set of zero or more algebraic equations that define relationships between quantity kinds in the set. In the physical sciences, the equations relating quantity kinds are typically physical laws and definitional relations, and constants of proportionality. Examples include Newton’s First Law of Motion, Coulomb’s Law, and the definition of velocity as the instantaneous change in position.  In almost all cases, the system identifies a subset of base quantity kinds. The base set is chosen so that all other quantity kinds of interest can be derived from the base quantity kinds and the algebraic equations. If the unit system is explicitly associated with a quantity kind system, then the unit system must define at least one unit for each quantity kind.  From a scientific point of view, the division of quantities into base quantities and derived quantities is a matter of convention.^^rdf:HTML" .

owl:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "A description of the entity" ;
    skos:inScheme <http://www.w3.org/2002/07/owl> .

owl:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "A unique identifier" ;
    skos:inScheme <http://www.w3.org/2002/07/owl> .

<https://dbpedia.org/ontology/black> a owl:DatatypeProperty ;
    rdfs:label "black" ;
    rdfs:range xsd:float ;
    skos:definition "Black component in CMYK color model" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/blue> a owl:DatatypeProperty ;
    rdfs:label "blue" ;
    rdfs:range xsd:integer ;
    skos:definition "Blue component in RGB color model (0-255)" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/cyanic> a owl:DatatypeProperty ;
    rdfs:label "cyanic" ;
    rdfs:range xsd:float ;
    skos:definition "Cyan component in CMYK color model" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/green> a owl:DatatypeProperty ;
    rdfs:label "green" ;
    rdfs:range xsd:integer ;
    skos:definition "Green component in RGB color model (0-255)" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/hue> a owl:DatatypeProperty ;
    rdfs:label "hue" ;
    rdfs:range xsd:float ;
    skos:definition "Hue component in HSV color model" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/magenta> a owl:DatatypeProperty ;
    rdfs:label "magenta" ;
    rdfs:range xsd:float ;
    skos:definition "Magenta component in CMYK color model" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/red> a owl:DatatypeProperty ;
    rdfs:label "red" ;
    rdfs:range xsd:integer ;
    skos:definition "Red component in RGB color model (0-255)" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/saturation> a owl:DatatypeProperty ;
    rdfs:label "saturation" ;
    rdfs:range xsd:float ;
    skos:definition "Saturation component in HSV color model" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/value> a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:range xsd:float ;
    skos:definition "Value/Lightness component in HSV color model" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/wavelength> a owl:DatatypeProperty ;
    rdfs:label "wavelength" ;
    rdfs:range xsd:float ;
    skos:definition "The wavelength of the color in nanometers" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/yellow> a owl:DatatypeProperty ;
    rdfs:label "yellow" ;
    rdfs:range xsd:float ;
    skos:definition "Yellow component in CMYK color model" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

pokemon:HabitatEnum a owl:Class ;
    rdfs:label "HabitatEnum" ;
    owl:oneOf ( pokemon:Habitat_Cave pokemon:Habitat_Forest pokemon:Habitat_Grassland ) ;
    skos:inScheme <https://pokemonkg.org/ontology> ;
    linkml:permissible_values pokemon:Habitat_Cave,
        pokemon:Habitat_Forest,
        pokemon:Habitat_Grassland .

pokemon:firmness a owl:DatatypeProperty ;
    rdfs:label "firmness" ;
    rdfs:domain pokemon:Food ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasCatchRate a owl:DatatypeProperty ;
    rdfs:label "hasCatchRate" ;
    rdfs:domain pokemon:Species ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasColour a owl:ObjectProperty ;
    rdfs:label "hasColour" ;
    rdfs:range <https://dbpedia.org/ontology/Colour> ;
    skos:definition "A Pokemon has a color" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasGenus a owl:DatatypeProperty ;
    rdfs:label "hasGenus" ;
    rdfs:domain pokemon:Species ;
    rdfs:range xsd:string ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasHeight a owl:ObjectProperty ;
    rdfs:label "hasHeight" ;
    rdfs:domain pokemon:Species ;
    rdfs:range qudt:Quantity ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasShape a owl:ObjectProperty ;
    rdfs:label "hasShape" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Shape ;
    skos:definition "The shape of a berry is a measure of how good it  is for making a Potion." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasSize a owl:DatatypeProperty ;
    rdfs:label "hasSize" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasWeight a owl:ObjectProperty ;
    rdfs:label "hasWeight" ;
    rdfs:domain pokemon:Species ;
    rdfs:range qudt:Quantity ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:smoothness a owl:DatatypeProperty ;
    rdfs:label "smoothness" ;
    rdfs:domain pokemon:Food ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

qudt:Aspect a owl:Class ;
    rdfs:label "Aspect" ;
    rdfs:subClassOf owl:Thing ;
    skos:exactMatch qudt:Aspect ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> ;
    skos:note "An aspect is an abstract type class that defines properties that can be reused.^^rdf:HTML" .

qudt:EndianType a owl:Class ;
    rdfs:label "EndianType" ;
    rdfs:subClassOf qudt:EnumeratedValue ;
    skos:definition "Endian Type" ;
    skos:exactMatch qudt:EndianType ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:isUnitOfSystem a owl:ObjectProperty ;
    rdfs:label "isUnitOfSystem" ;
    rdfs:range qudt:SystemOfUnits ;
    skos:definition "This property relates a unit of measure with a system of units that either a) defines the unit or b) allows the unit to be used within the system." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

pokemon:Food a owl:Class ;
    rdfs:label "Food" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:firmness ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:smoothness ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty pokemon:firmness ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasFlavor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:firmness ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Flavor ;
            owl:onProperty pokemon:hasFlavor ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty pokemon:smoothness ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:smoothness ],
        pokemon:Item ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:MoveLearning a owl:Class ;
    rdfs:label "MoveLearning" ;
    skos:definition "A move learning is a way that a Pokemon can learn a move." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:PokedexEntry a owl:Class ;
    rdfs:label "PokedexEntry" ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "A pokedex entry is a description of a Pokemon." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Type a owl:Class ;
    rdfs:label "Type" ;
    rdfs:comment "All Pokemon creatures and their moves are assigned certain types. Each type has several strengths and weaknesses in both attack and defense." ;
    rdfs:subClassOf owl:NamedIndividual ;
    skos:exactMatch pokemon:Type ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:effectDescription a owl:DatatypeProperty ;
    rdfs:label "effectDescription" ;
    rdfs:range xsd:string ;
    skos:definition "A description of the effect of the entity" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasType a owl:ObjectProperty ;
    rdfs:label "hasType" ;
    rdfs:range pokemon:Type ;
    skos:definition "A Pokemon has a type" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

qudt:Prefix a owl:Class ;
    rdfs:label "Prefix" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:latexSymbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:UCUMcs-term ;
            owl:onProperty pokemon:ucumCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Prefix ;
            owl:onProperty pokemon:exactMatch ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:symbol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:symbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:altSymbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:prefixMultiplier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:prefixMultiplier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:latexSymbol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:exactMatch ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:ucumCode ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:altSymbol ],
        qudt:Concept,
        qudt:Verifiable ;
    skos:definition "Prefix" ;
    skos:exactMatch qudt:Prefix ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:applicableUnit a owl:ObjectProperty ;
    rdfs:label "applicableUnit" ;
    rdfs:range qudt:Unit ;
    skos:definition "See https://github.com/qudt/qudt-public-repo/wiki/Advanced-User-Guide#4-computing-applicable-units-for-a-quantitykind on how `qudt:applicableUnit` is computed from `qudt:hasQuantityKind` and then materialized" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

pokemon:Ability a owl:Class ;
    rdfs:label "Ability" ;
    rdfs:comment "Abilities were introduced in Generation III as an all new game mechanic. Each and every Pokemon has an ability, and can only have one at a time. Some abilities are exclusive to certain Pokemon and Evolution lines, while others are known by many Pokemon." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:effectDescription ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:effectDescription ],
        owl:Thing ;
    skos:exactMatch pokemon:Ability ;
    skos:inScheme <https://pokemonkg.org/ontology> .

qudt:Quantity a owl:Class ;
    rdfs:label "Quantity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:isDeltaQuantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:QuantityValue ;
            owl:onProperty pokemon:quantityValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:quantityValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty pokemon:isDeltaQuantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:QuantityKind ;
            owl:onProperty pokemon:hasQuantityKind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasQuantityKind ],
        qudt:Concept,
        qudt:Quantifiable ;
    skos:definition """<p class="lm-para">A <b>quantity</b> is the measurement of an observable property of a particular object, event, or physical system.
  A quantity is always associated with the context of measurement (i.e. the thing measured, the measured value, the accuracy of measurement, etc.) whereas the
  underlying <b>quantity kind</b> is independent of any particular measurement. Thus, length is a quantity kind while the height of a rocket is a specific
  quantity of length; its magnitude that may be expressed in meters, feet, inches, etc. Examples of physical quantities include physical constants, such as
  the speed of light in a vacuum, Planck's constant, the electric permittivity of free space, and the fine structure constant. </p>
<p class="lm-para">In other words, quantities are quantifiable aspects of the world, such as the duration of a movie, the distance between two points,
velocity of a car, the pressure of the atmosphere, and a person's weight; and units are used to describe their numerical measure.</p>
<p class="lm-para">Many <b>quantity kinds</b> are related to each other by various physical laws, and as a result, the associated units of some quantity
kinds can be expressed as products (or ratios) of powers of other quantity kinds (e.g., momentum is mass times velocity and velocity is defined as distance
divided by time). In this way, some quantities can be calculated from other measured quantities using their associations to the quantity kinds in these
expressions. These quantity kind relationships are also discussed in dimensional analysis. Those that cannot be so expressed can be regarded
as "fundamental" in this sense.</p>
<p class="lm-para">A quantity is distinguished from a "quantity kind" in that the former carries a value and the latter is a type specifier.</p>""" ;
    skos:exactMatch qudt:Quantity ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> ;
    skos:note """<p class=\\"lm-para\\">A <b>quantity</b> is the measurement of an observable property of a particular object, event, or physical system.
  A quantity is always associated with the context of measurement (i.e. the thing measured, the measured value, the accuracy of measurement, etc.) whereas the
  underlying <b>quantity kind</b> is independent of any particular measurement. Thus, length is a quantity kind while the height of a rocket is a specific
  quantity of length; its magnitude that may be expressed in meters, feet, inches, etc. Examples of physical quantities include physical constants, such as
  the speed of light in a vacuum, Planck's constant, the electric permittivity of free space, and the fine structure constant. </p>
<p class=\\"lm-para\\">In other words, quantities are quantifiable aspects of the world, such as the duration of a movie, the distance between two points,
velocity of a car, the pressure of the atmosphere, and a person's weight; and units are used to describe their numerical measure.</p>
<p class=\\"lm-para\\">Many <b>quantity kinds</b> are related to each other by various physical laws, and as a result, the associated units of some quantity
kinds can be expressed as products (or ratios) of powers of other quantity kinds (e.g., momentum is mass times velocity and velocity is defined as distance
divided by time). In this way, some quantities can be calculated from other measured quantities using their associations to the quantity kinds in these
expressions. These quantity kind relationships are also discussed in dimensional analysis. Those that cannot be so expressed can be regarded
as \\"fundamental\\" in this sense.</p>
<p class=\\"lm-para\\">A quantity is distinguished from a \\"quantity kind\\" in that the former carries a value and the latter is a type specifier.</p>^^rdf:HTML""" .

owl:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable label for the entity" ;
    skos:inScheme <http://www.w3.org/2002/07/owl> .

foaf:depiction a owl:DatatypeProperty ;
    rdfs:label "depiction" ;
    rdfs:range xsd:string ;
    skos:definition "A depiction of the person" ;
    skos:inScheme foaf: .

qudt:EnumeratedValue a owl:Class ;
    rdfs:label "EnumeratedValue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:symbol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:altSymbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:qudt_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:abbreviation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:symbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:altSymbol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:qudt_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:abbreviation ],
        qudt:Concept,
        qudt:Verifiable ;
    skos:definition """<p>This class is for all enumerated and/or coded values.  For example, it contains the dimension objects that are the basis elements in some abstract vector space associated with a quantity kind system. Another use is for the base dimensions for quantity systems. Each quantity kind system that defines a base set has a corresponding ordered enumeration whose elements are the dimension objects for the base quantity kinds. The order of the dimensions in the enumeration determines the canonical order of the basis elements in the corresponding abstract vector space.</p>

<p>An enumeration is a set of literals from which a single value is selected. Each literal can have a tag as an integer within a standard encoding appropriate to the range of integer values. Consistency of enumeration types will allow them, and the enumerated values, to be referred to unambiguously either through symbolic name or encoding. Enumerated values are also controlled vocabularies and as such need to be standardized. Without this consistency enumeration literals can be stated differently and result in  data conflicts and misinterpretations.</p>

<p>The tags are a set of positive whole numbers, not necessarily contiguous and having no numerical significance, each corresponding to the associated literal identifier. An order attribute can also be given on the enumeration elements. An enumeration can itself be a member of an enumeration. This allows enumerations to be enumerated in a selection. Enumerations are also subclasses of Scalar Datatype. This allows them to be used as the reference of a datatype specification.</p>""" ;
    skos:exactMatch qudt:EnumeratedValue ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:Verifiable a owl:Class ;
    rdfs:label "Verifiable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:normativeReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:isoNormativeReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:dbpediaMatch ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:dbpediaMatch ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:isoNormativeReference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:wikidataMatch ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:wikidataMatch ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:normativeReference ],
        qudt:Aspect ;
    skos:exactMatch qudt:Verifiable ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> ;
    skos:note "An aspect class that holds properties that provide external knowledge and specifications of a given resource." .

pokemon:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "An item is an object in the Pokémon games which the player can pick up, keep in their Bag, and use in some manner. They have various uses, including healing, powering up, helping one to catch Pokémon, or to access a new area." ;
    rdfs:subClassOf owl:Thing ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Place a owl:Class ;
    rdfs:label "Place" ;
    rdfs:comment "Entities that have a somewhat fixed, physical extension." ;
    rdfs:subClassOf owl:Thing ;
    skos:inScheme <https://pokemonkg.org/ontology> .

qudt:SystemOfUnits a owl:Class ;
    rdfs:label "SystemOfUnits" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom qudt:PhysicalConstant ;
            owl:onProperty pokemon:applicablePhysicalConstant ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasDerivedUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Unit ;
            owl:onProperty pokemon:hasDerivedUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasCoherentUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:prefix ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasBaseUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Unit ;
            owl:onProperty pokemon:hasDefinedUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Prefix ;
            owl:onProperty pokemon:prefix ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Unit ;
            owl:onProperty pokemon:hasCoherentUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasDerivedCoherentUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasAllowedUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Unit ;
            owl:onProperty pokemon:hasBaseUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasDefinedUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Unit ;
            owl:onProperty pokemon:hasDerivedCoherentUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Unit ;
            owl:onProperty pokemon:hasUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Unit ;
            owl:onProperty pokemon:hasAllowedUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:applicablePhysicalConstant ],
        qudt:Concept,
        qudt:Verifiable ;
    skos:definition "A system of units is a set of units which are chosen as the reference scales for some set of quantity kinds together with the definitions of each unit. Units may be defined by experimental observation or by proportion to another unit not included in the system. If the unit system is explicitly associated with a quantity kind system, then the unit system must define at least one unit for each quantity kind." ;
    skos:exactMatch qudt:SystemOfUnits ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> ;
    skos:note "A system of units is a set of units which are chosen as the reference scales for some set of quantity kinds together with the definitions of each unit. Units may be defined by experimental observation or by proportion to another unit not included in the system. If the unit system is explicitly associated with a quantity kind system, then the unit system must define at least one unit for each quantity kind.^^rdf:HTML" .

