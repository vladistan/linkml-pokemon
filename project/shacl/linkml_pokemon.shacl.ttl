            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dbpedia:cmykCoordinateMagenta ],
        [ sh:datatype xsd:integer ;
            sh:description "Green component in RGB color model (0-255)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dbpedia:rgbCoordinateGreen ],
        [ sh:datatype xsd:float ;
            sh:description "Cyan component in CMYK color model" ;
