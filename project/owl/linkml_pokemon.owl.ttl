@prefix dbpedia: <http://dbpedia.org/ontology/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix pokemon: <https://pokemonkg.org/ontology#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pokemon:BattleItem a owl:Class ;
    rdfs:label "BattleItem" ;
    rdfs:subClassOf pokemon:Item ;
    skos:definition "Battle items are items that can be used during battles." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Berry a owl:Class ;
    rdfs:label "Berry" ;
    rdfs:comment "Berries are small, juicy, fleshy fruit. As in the real world, a large variety exists in the Pokémon world, with a large range of flavors, names, and effects. First found in the Generation II games, many Berries have since became critical help items in battle, where their various effects include HP and status condition restoration, stat enhancement, and even damage negation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:hasSize ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasSize ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:hasSize ],
        pokemon:Food ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Game a owl:Class ;
    rdfs:label "Game" ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "A game is a type of media that can be played by people." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Generation a owl:Class ;
    rdfs:label "Generation" ;
    rdfs:comment "Generations refers to the Pokemon game series. It is a group of games that were released at or around the same time. It also means that games in the same generation are compatible with the others, containing the same Pokemon and the number of moves there are to be learned." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:featuresSpecies ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Species ;
            owl:onProperty pokemon:featuresSpecies ],
        owl:Thing ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Gym a owl:Class ;
    rdfs:label "Gym" ;
    rdfs:subClassOf pokemon:Place ;
    skos:definition "A gym is a location that can be battled at." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:GymLeader a owl:Class ;
    rdfs:label "GymLeader" ;
    rdfs:comment "A gym leader is the highest ranking member and owner of an official Pokémon gym. Gym leaders use their gym and their Pokemon to test the skills of trainers that challenge them, and if said trainers win a battle, the gym leader will gift them a badge that's unique to that specific gym." ;
    rdfs:subClassOf pokemon:Trainer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:HM a owl:Class ;
    rdfs:label "HM" ;
    rdfs:subClassOf pokemon:Item ;
    skos:definition "Hidden Machine" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:HoldItem a owl:Class ;
    rdfs:label "HoldItem" ;
    rdfs:subClassOf pokemon:Item ;
    skos:definition "A hold item is an item that can be held by a Pokemon." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:LearningByLevelingUp a owl:Class ;
    rdfs:label "LearningByLevelingUp" ;
    rdfs:subClassOf pokemon:MoveLearning ;
    skos:definition "A move that is learned by leveling up." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:LearningThroughBreeding a owl:Class ;
    rdfs:label "LearningThroughBreeding" ;
    rdfs:subClassOf pokemon:MoveLearning ;
    skos:definition "A move that is learned by breeding." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Medicine a owl:Class ;
    rdfs:label "Medicine" ;
    rdfs:subClassOf pokemon:Item ;
    skos:definition "Medicine items can heal various afflictions of a Pokemon." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:PhysicalMove a owl:Class ;
    rdfs:label "PhysicalMove" ;
    rdfs:subClassOf pokemon:Move ;
    skos:definition "A physical move is a type of move that can be used during battles." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Pokeball a owl:Class ;
    rdfs:label "Pokeball" ;
    rdfs:comment "A Poké Ball is a type of item that is critical to a Trainer's quest, used for catching and storing Pokémon." ;
    rdfs:subClassOf pokemon:Item ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Pokemon a owl:Class ;
    rdfs:label "Pokemon" ;
    rdfs:seeAlso "<https://dbpedia.org/resource/Pokémon>" ;
    skos:definition "A Pokemon" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "Regions are areas in the Pokémon universe that are smaller parts of a nation." ;
    rdfs:subClassOf pokemon:Place ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:SpecialMove a owl:Class ;
    rdfs:label "SpecialMove" ;
    rdfs:subClassOf pokemon:Move ;
    skos:definition "A special move is a type of move that can be used during battles." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:StatusMove a owl:Class ;
    rdfs:label "StatusMove" ;
    rdfs:subClassOf pokemon:Move ;
    skos:definition "A status move is a type of move that can be used during battles." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:TM a owl:Class ;
    rdfs:label "TM" ;
    rdfs:comment "A Technical Machine is an item that can be used to teach a Pokemon a move." ;
    rdfs:subClassOf pokemon:Item,
        pokemon:MoveLearning ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Town a owl:Class ;
    rdfs:label "Town" ;
    rdfs:subClassOf pokemon:Place ;
    skos:definition "A town is a type of place that can be visited." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:accuracy a owl:DatatypeProperty ;
    rdfs:label "accuracy" ;
    rdfs:domain pokemon:Move ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:basePower a owl:DatatypeProperty ;
    rdfs:label "basePower" ;
    rdfs:domain pokemon:Move ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:basePowerPoints a owl:DatatypeProperty ;
    rdfs:label "basePowerPoints" ;
    rdfs:domain pokemon:Move ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:containsPlace a owl:AsymmetricProperty,
        owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "containsPlace" ;
    rdfs:comment "A place is contained to some extent in this place." ;
    rdfs:domain pokemon:Place ;
    rdfs:range pokemon:Place ;
    owl:inverseOf pokemon:locatedIn ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:describedInPokedex a owl:ObjectProperty ;
    rdfs:label "describedInPokedex" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:PokedexEntry ;
    owl:inverseOf pokemon:describesPokemon ;
    skos:definition "['A Pokedex entry is described in a Pokedex']" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:entryNumber a owl:DatatypeProperty ;
    rdfs:label "entryNumber" ;
    rdfs:domain pokemon:PokedexEntry ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasPokedexEntry a owl:ObjectProperty ;
    rdfs:label "hasPokedexEntry" ;
    rdfs:comment "A Pokedex entry in which this Pokemon is described." ;
    rdfs:domain pokemon:Pokedex ;
    rdfs:range pokemon:PokedexEntry ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:learnsMove a owl:ObjectProperty ;
    rdfs:label "learnsMove" ;
    rdfs:domain pokemon:MoveLearning ;
    rdfs:range pokemon:Move ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:maxPowerPoints a owl:DatatypeProperty ;
    rdfs:label "maxPowerPoints" ;
    rdfs:domain pokemon:Move ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:minLevelToLearn a owl:DatatypeProperty ;
    rdfs:label "minLevelToLearn" ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

<https://pokemonkg.org/ontology.owl.ttl> a owl:Ontology ;
    rdfs:label "linkml-pokemon" ;
    dcterms:license "MIT" ;
    dcterms:title "Pokemon Ontology" ;
    pav:createdOn "2019-07-27T00:00:00" ;
    rdfs:seeAlso <https://vladistan.github.io/linkml-pokemon> ;
    skos:definition "Ontology covering the Pokémon world as it is presented in games and anime television series" .

<http://qudt.org/2.1/vocab/unit/QuantityKind> a owl:Class ;
    rdfs:label "QuantityKind" ;
    skos:exactMatch qudt:QuantityKind ;
    skos:inScheme <http://qudt.org/2.1/vocab/unit> ;
    skos:note "A <b>Quantity Kind</b> is any observable property that can be  measured and quantified numerically. Familiar examples include physical properties such as length, mass, time, force, energy, power, electric charge, etc. Less familiar examples include currency, interest rate, price to earning ratio, and information capacity.^^rdf:HTML" .

pokemon:Pokedex a owl:Class ;
    rdfs:label "Pokedex" ;
    rdfs:comment "The Pokedex is an electronic device designed to catalogue and provide information regarding the various species of Pokemon featured in the Pokemon video game, anime and manga series." ;
    rdfs:subClassOf owl:Thing ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Trainer a owl:Class ;
    rdfs:label "Trainer" ;
    rdfs:subClassOf foaf:Person ;
    skos:definition "A trainer is a person who is able to catch Pokemon." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:describesPokemon a owl:ObjectProperty ;
    rdfs:label "describesPokemon" ;
    rdfs:comment "A Pokemon that is described by this Pokedex entry." ;
    rdfs:domain pokemon:PokedexEntry ;
    rdfs:range pokemon:Species ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:evolvesFrom a owl:ObjectProperty ;
    rdfs:label "evolvesFrom" ;
    rdfs:comment "This species evolves the other species." ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Species ;
    owl:inverseOf pokemon:evolvesTo ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:evolvesTo a owl:ObjectProperty ;
    rdfs:label "evolvesTo" ;
    rdfs:comment "A Pokemon evolves to another Pokemon." ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Species ;
    owl:inverseOf pokemon:evolvesFrom ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:locatedIn a owl:AsymmetricProperty,
        owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "locatedIn" ;
    rdfs:comment "This place is located to some extent in another place." ;
    rdfs:domain pokemon:Place ;
    rdfs:range pokemon:Place ;
    skos:inScheme <https://pokemonkg.org/ontology> .

<http://qudt.org/2.1/vocab/unit/Unit> a owl:Class ;
    rdfs:label "Unit" ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "A unit of measure." ;
    skos:exactMatch qudt:Unit ;
    skos:inScheme <http://qudt.org/2.1/vocab/unit> ;
    skos:note "A <b>Unit</b> is a particular quantity value that has been chosen as a scale for measuring other quantities of the same kind (e.g., meter for length, kilogram for mass, second for time)." .

<http://qudt.org/2.1/vocab/unit/hasUnit> a owl:ObjectProperty ;
    rdfs:label "hasUnit" ;
    rdfs:range <http://qudt.org/2.1/vocab/unit/Unit> ;
    skos:inScheme <http://qudt.org/2.1/vocab/unit> .

foaf:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty foaf:depiction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty foaf:depiction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty foaf:depiction ],
        owl:NamedIndividual ;
    skos:definition "A person is a human being" ;
    skos:exactMatch foaf:Person ;
    skos:inScheme foaf: .

<https://dbpedia.org/ontology/Colour> a owl:Class ;
    rdfs:label "Colour" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/black> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/red> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/yellow> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://dbpedia.org/ontology/hue> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://dbpedia.org/ontology/cyanic> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/wavelength> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/red> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://dbpedia.org/ontology/wavelength> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/cyanic> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/green> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://dbpedia.org/ontology/black> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://dbpedia.org/ontology/value> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/saturation> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/yellow> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/magenta> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty <https://dbpedia.org/ontology/red> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://dbpedia.org/ontology/yellow> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/green> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty <https://dbpedia.org/ontology/green> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://dbpedia.org/ontology/saturation> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/blue> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/magenta> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/hue> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/hue> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/blue> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty <https://dbpedia.org/ontology/blue> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/saturation> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/wavelength> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://dbpedia.org/ontology/magenta> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/cyanic> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://dbpedia.org/ontology/black> ],
        owl:Thing ;
    skos:definition "Color or colour is the visual perceptual property corresponding in humans to the categories called red, yellow, blue and others." ;
    skos:exactMatch dbpedia:Colour ;
    skos:inScheme <https://dbpedia.org/ontology/> .

pokemon:EggGroup a owl:Class ;
    rdfs:label "EggGroup" ;
    rdfs:comment "Egg group is a category that determines which Pokemon are able to interbreed. The concept was introduced in Generation II, along with breeding. Similar to types, a Pokémon may belong to either one or two egg groups." ;
    rdfs:subClassOf owl:NamedIndividual ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Flavor a owl:Class ;
    rdfs:label "Flavor" ;
    rdfs:comment "Flavor is a special set of attributes that certain foods in the Pokémon world have. Most of the foods can have more than one flavor, and the flavor determines which Pokemon can eat them." ;
    rdfs:subClassOf owl:NamedIndividual ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Habitat a owl:Class ;
    rdfs:label "Habitat" ;
    rdfs:subClassOf owl:NamedIndividual ;
    skos:definition "A habitat is a type of environment that certain Pokemon belong to." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Habitat_Cave a owl:NamedIndividual,
        pokemon:HabitatEnum ;
    rdfs:label "Cave" .

pokemon:Habitat_Forest a owl:NamedIndividual,
        pokemon:HabitatEnum ;
    rdfs:label "Forest" .

pokemon:Habitat_Grassland a owl:NamedIndividual,
        pokemon:HabitatEnum ;
    rdfs:label "Grassland" .

pokemon:Shape a owl:Class ;
    rdfs:label "Shape" ;
    rdfs:subClassOf owl:NamedIndividual ;
    skos:definition "Shapes are categories that certain Pokemon belong to, which determine which Pokemon they can breed with." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:featuresSpecies a owl:ObjectProperty ;
    rdfs:label "featuresSpecies" ;
    rdfs:range pokemon:Species ;
    skos:definition "['A Pokedex entry features a species']" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:foundIn a owl:ObjectProperty ;
    rdfs:label "foundIn" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Habitat ;
    skos:definition "A place is found in a location" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasFlavor a owl:ObjectProperty ;
    rdfs:label "hasFlavor" ;
    rdfs:domain pokemon:Food ;
    rdfs:range pokemon:Flavor ;
    skos:definition "A Pokemon has a flavor" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:inEggGroup a owl:ObjectProperty ;
    rdfs:label "inEggGroup" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:EggGroup ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:isAbleToApply a owl:ObjectProperty ;
    rdfs:label "isAbleToApply" ;
    rdfs:range pokemon:Move ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:mayHaveAbility a owl:ObjectProperty ;
    rdfs:label "mayHaveAbility" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Ability ;
    skos:definition "A Pokemon may have an ability" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:mayHaveHiddenAbility a owl:ObjectProperty ;
    rdfs:label "mayHaveHiddenAbility" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Ability ;
    skos:inScheme <https://pokemonkg.org/ontology> .

<http://qudt.org/2.1/vocab/unit/hasQuantityKind> a owl:DatatypeProperty ;
    rdfs:label "hasQuantityKind" ;
    skos:definition "The kind of quantity (e.g., Length, Mass, Time)." ;
    skos:inScheme <http://qudt.org/2.1/vocab/unit> .

<http://qudt.org/2.1/vocab/unit/hasValue> a owl:DatatypeProperty ;
    rdfs:label "hasValue" ;
    skos:definition "The numeric value of the quantity." ;
    skos:inScheme <http://qudt.org/2.1/vocab/unit> .

owl:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "A description of the entity" ;
    skos:inScheme <http://www.w3.org/2002/07/owl> .

owl:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "A unique identifier" ;
    skos:inScheme <http://www.w3.org/2002/07/owl> .

<https://dbpedia.org/ontology/black> a owl:DatatypeProperty ;
    rdfs:label "black" ;
    rdfs:range xsd:float ;
    skos:definition "Black component in CMYK color model" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/blue> a owl:DatatypeProperty ;
    rdfs:label "blue" ;
    rdfs:range xsd:integer ;
    skos:definition "Blue component in RGB color model (0-255)" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/cyanic> a owl:DatatypeProperty ;
    rdfs:label "cyanic" ;
    rdfs:range xsd:float ;
    skos:definition "Cyan component in CMYK color model" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/green> a owl:DatatypeProperty ;
    rdfs:label "green" ;
    rdfs:range xsd:integer ;
    skos:definition "Green component in RGB color model (0-255)" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/hue> a owl:DatatypeProperty ;
    rdfs:label "hue" ;
    rdfs:range xsd:float ;
    skos:definition "Hue component in HSV color model" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/magenta> a owl:DatatypeProperty ;
    rdfs:label "magenta" ;
    rdfs:range xsd:float ;
    skos:definition "Magenta component in CMYK color model" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/red> a owl:DatatypeProperty ;
    rdfs:label "red" ;
    rdfs:range xsd:integer ;
    skos:definition "Red component in RGB color model (0-255)" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/saturation> a owl:DatatypeProperty ;
    rdfs:label "saturation" ;
    rdfs:range xsd:float ;
    skos:definition "Saturation component in HSV color model" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/value> a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:range xsd:float ;
    skos:definition "Value/Lightness component in HSV color model" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/wavelength> a owl:DatatypeProperty ;
    rdfs:label "wavelength" ;
    rdfs:range xsd:float ;
    skos:definition "The wavelength of the color in nanometers" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

<https://dbpedia.org/ontology/yellow> a owl:DatatypeProperty ;
    rdfs:label "yellow" ;
    rdfs:range xsd:float ;
    skos:definition "Yellow component in CMYK color model" ;
    skos:inScheme <https://dbpedia.org/ontology/> .

pokemon:HabitatEnum a owl:Class ;
    rdfs:label "HabitatEnum" ;
    owl:oneOf ( pokemon:Habitat_Cave pokemon:Habitat_Forest pokemon:Habitat_Grassland ) ;
    skos:inScheme <https://pokemonkg.org/ontology> ;
    linkml:permissible_values pokemon:Habitat_Cave,
        pokemon:Habitat_Forest,
        pokemon:Habitat_Grassland .

pokemon:firmness a owl:DatatypeProperty ;
    rdfs:label "firmness" ;
    rdfs:domain pokemon:Food ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasCatchRate a owl:DatatypeProperty ;
    rdfs:label "hasCatchRate" ;
    rdfs:domain pokemon:Species ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasColour a owl:ObjectProperty ;
    rdfs:label "hasColour" ;
    rdfs:range <https://dbpedia.org/ontology/Colour> ;
    skos:definition "A Pokemon has a color" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasGenus a owl:DatatypeProperty ;
    rdfs:label "hasGenus" ;
    rdfs:domain pokemon:Species ;
    rdfs:range xsd:string ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasHeight a owl:ObjectProperty ;
    rdfs:label "hasHeight" ;
    rdfs:domain pokemon:Species ;
    rdfs:range <http://qudt.org/2.1/vocab/unit/Quantity> ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasShape a owl:ObjectProperty ;
    rdfs:label "hasShape" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Shape ;
    skos:definition "The shape of a berry is a measure of how good it  is for making a Potion." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasSize a owl:DatatypeProperty ;
    rdfs:label "hasSize" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasWeight a owl:ObjectProperty ;
    rdfs:label "hasWeight" ;
    rdfs:domain pokemon:Species ;
    rdfs:range <http://qudt.org/2.1/vocab/unit/Quantity> ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:smoothness a owl:DatatypeProperty ;
    rdfs:label "smoothness" ;
    rdfs:domain pokemon:Food ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

<http://qudt.org/2.1/vocab/unit/Quantity> a owl:Class ;
    rdfs:label "Quantity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://qudt.org/2.1/vocab/unit/hasUnit> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://qudt.org/2.1/vocab/unit/Unit> ;
            owl:onProperty <http://qudt.org/2.1/vocab/unit/hasUnit> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://qudt.org/2.1/vocab/unit/hasQuantityKind> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://qudt.org/2.1/vocab/unit/hasValue> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://qudt.org/2.1/vocab/unit/QuantityKind> ;
            owl:onProperty <http://qudt.org/2.1/vocab/unit/hasQuantityKind> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://qudt.org/2.1/vocab/unit/hasValue> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://qudt.org/2.1/vocab/unit/hasQuantityKind> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://qudt.org/2.1/vocab/unit/hasValue> ],
        owl:Thing ;
    skos:definition "A physical quantity." ;
    skos:exactMatch qudt:Quantity ;
    skos:inScheme <http://qudt.org/2.1/vocab/unit> ;
    skos:note """<p class=\\"lm-para\\">A <b>quantity</b> is the measurement of an observable property of a particular object, event, or physical system. 
  A quantity is always associated with the context of measurement (i.e. the thing measured, the measured value, the accuracy of measurement, etc.) whereas the 
  underlying <b>quantity kind</b> is independent of any particular measurement. Thus, length is a quantity kind while the height of a rocket is a specific 
  quantity of length; its magnitude that may be expressed in meters, feet, inches, etc. Examples of physical quantities include physical constants, such as 
  the speed of light in a vacuum, Planck's constant, the electric permittivity of free space, and the fine structure constant. </p>
<p class=\\"lm-para\\">In other words, quantities are quantifiable aspects of the world, such as the duration of a movie, the distance between two points, 
velocity of a car, the pressure of the atmosphere, and a person's weight; and units are used to describe their numerical measure.</p> 
<p class=\\"lm-para\\">Many <b>quantity kinds</b> are related to each other by various physical laws, and as a result, the associated units of some quantity 
kinds can be expressed as products (or ratios) of powers of other quantity kinds (e.g., momentum is mass times velocity and velocity is defined as distance 
divided by time). In this way, some quantities can be calculated from other measured quantities using their associations to the quantity kinds in these 
expressions. These quantity kind relationships are also discussed in dimensional analysis. Those that cannot be so expressed can be regarded 
as \\"fundamental\\" in this sense.</p>
<p class=\\"lm-para\\">A quantity is distinguished from a \\"quantity kind\\" in that the former carries a value and the latter is a type specifier.</p>^^rdf:HTML""" .

pokemon:Food a owl:Class ;
    rdfs:label "Food" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:smoothness ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:firmness ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:firmness ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasFlavor ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty pokemon:smoothness ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:smoothness ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Flavor ;
            owl:onProperty pokemon:hasFlavor ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty pokemon:firmness ],
        pokemon:Item ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:MoveLearning a owl:Class ;
    rdfs:label "MoveLearning" ;
    skos:definition "A move learning is a way that a Pokemon can learn a move." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:PokedexEntry a owl:Class ;
    rdfs:label "PokedexEntry" ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "A pokedex entry is a description of a Pokemon." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Type a owl:Class ;
    rdfs:label "Type" ;
    rdfs:comment "All Pokemon creatures and their moves are assigned certain types. Each type has several strengths and weaknesses in both attack and defense." ;
    rdfs:subClassOf owl:NamedIndividual ;
    skos:exactMatch pokemon:Type ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:effectDescription a owl:DatatypeProperty ;
    rdfs:label "effectDescription" ;
    rdfs:range xsd:string ;
    skos:definition "A description of the effect of the entity" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasType a owl:ObjectProperty ;
    rdfs:label "hasType" ;
    rdfs:range pokemon:Type ;
    skos:definition "A Pokemon has a type" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Ability a owl:Class ;
    rdfs:label "Ability" ;
    rdfs:comment "Abilities were introduced in Generation III as an all new game mechanic. Each and every Pokemon has an ability, and can only have one at a time. Some abilities are exclusive to certain Pokemon and Evolution lines, while others are known by many Pokemon." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:effectDescription ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:effectDescription ],
        owl:Thing ;
    skos:exactMatch pokemon:Ability ;
    skos:inScheme <https://pokemonkg.org/ontology> .

owl:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable label for the entity" ;
    skos:inScheme <http://www.w3.org/2002/07/owl> .

foaf:depiction a owl:DatatypeProperty ;
    rdfs:label "depiction" ;
    rdfs:range xsd:string ;
    skos:definition "A depiction of the person" ;
    skos:inScheme foaf: .

pokemon:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "An item is an object in the Pokémon games which the player can pick up, keep in their Bag, and use in some manner. They have various uses, including healing, powering up, helping one to catch Pokémon, or to access a new area." ;
    rdfs:subClassOf owl:Thing ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Place a owl:Class ;
    rdfs:label "Place" ;
    rdfs:comment "Entities that have a somewhat fixed, physical extension." ;
    rdfs:subClassOf owl:Thing ;
    skos:inScheme <https://pokemonkg.org/ontology> .

owl:NamedIndividual a owl:Class ;
    rdfs:label "NamedIndividual" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty owl:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty owl:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty owl:name ],
        owl:Thing ;
    skos:definition "A Thing that requires a name" ;
    skos:exactMatch owl:NamedIndividual ;
    skos:inScheme <http://www.w3.org/2002/07/owl> .

pokemon:Move a owl:Class ;
    rdfs:label "Move" ;
    rdfs:comment "A move is a special ability of a Pokemon." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:effectDescription ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasType ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Type ;
            owl:onProperty pokemon:hasType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:effectDescription ],
        owl:Thing ;
    skos:exactMatch pokemon:Move ;
    skos:inScheme <https://pokemonkg.org/ontology> .

owl:Thing a owl:Class ;
    rdfs:label "Thing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty owl:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty owl:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty owl:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty owl:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty owl:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty owl:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty owl:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty owl:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty owl:description ] ;
    skos:definition "An rdfs:Resource that defines name and description" ;
    skos:exactMatch owl:Thing ;
    skos:inScheme <http://www.w3.org/2002/07/owl> .

pokemon:Species a owl:Class ;
    rdfs:label "Species" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Type ;
            owl:onProperty pokemon:hasType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:mayHaveHiddenAbility ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:inEggGroup ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasGenus ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:hasHeight ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Shape ;
            owl:onProperty pokemon:hasShape ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://qudt.org/2.1/vocab/unit/Quantity> ;
            owl:onProperty pokemon:hasHeight ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasType ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Move ;
            owl:onProperty pokemon:isAbleToApply ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Habitat ;
            owl:onProperty pokemon:foundIn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:hasShape ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasColour ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:hasCatchRate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:hasWeight ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:hasGenus ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:hasGenus ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:mayHaveAbility ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:isAbleToApply ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty foaf:depiction ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:EggGroup ;
            owl:onProperty pokemon:inEggGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty pokemon:hasCatchRate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:foundIn ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Ability ;
            owl:onProperty pokemon:mayHaveHiddenAbility ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Ability ;
            owl:onProperty pokemon:mayHaveAbility ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasWeight ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasShape ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasCatchRate ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://dbpedia.org/ontology/Colour> ;
            owl:onProperty pokemon:hasColour ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty foaf:depiction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:hasColour ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasHeight ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty foaf:depiction ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://qudt.org/2.1/vocab/unit/Quantity> ;
            owl:onProperty pokemon:hasWeight ],
        owl:NamedIndividual ;
    skos:definition "A species is a category of Pokemon that share common features." ;
    skos:exactMatch pokemon:Species ;
    skos:inScheme <https://pokemonkg.org/ontology> .


