            owl:onProperty pokemon:hasColor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:hasGenus ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:EggGroup ;
            owl:onProperty pokemon:inEggGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Quantity ;
            owl:onProperty pokemon:hasWeight ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Type ;
            owl:onProperty pokemon:hasType ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Ability ;
            owl:onProperty pokemon:mayHaveHiddenAbility ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:hasHeight ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://dbpedia.org/ontology/Color> ;
            owl:onProperty pokemon:hasColor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasHeight ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasShape ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasType ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Shape ;
            owl:onProperty pokemon:hasShape ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:foundIn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:hasShape ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:mayHaveHiddenAbility ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasGenus ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:hasCatchRate ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Habitat ;
            owl:onProperty pokemon:foundIn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasWeight ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty foaf:depiction ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Ability ;
            owl:onProperty pokemon:mayHaveAbility ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty foaf:depiction ],
        [ a owl:Restriction ;
