@prefix dbpedia: <http://dbpedia.org/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix linkml_common: <https://w3id.org/linkml/common/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pokemon: <https://pokemonkg.org/ontology#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

owl:NamedIndividual a sh:NodeShape ;
    sh:closed false ;
    sh:description "A Thing that requires a name" ;
    sh:ignoredProperties ( pokemon:isAbleToApply pokemon:inEggGroup pokemon:mayHaveHiddenAbility pokemon:hasCatchRate pokemon:hasType pokemon:hasWeight pokemon:foundIn pokemon:hasShape pokemon:hasColour foaf:depiction rdf:type pokemon:mayHaveAbility pokemon:hasHeight pokemon:hasGenus ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A description of the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:anyURI ;
            sh:description "A unique identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path linkml_common:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ] ;
    sh:targetClass owl:NamedIndividual .

owl:Thing a sh:NodeShape ;
    sh:closed false ;
    sh:description "An rdfs:Resource that defines name and description" ;
    sh:ignoredProperties ( dbpedia:cmykCoordinateBlack pokemon:featuresSpecies dbpedia:wavelength qudt:quantityValue dbpedia:rgbCoordinateGreen qudt:hasUnit pokemon:foundIn dbpedia:cmykCoordinateYellow rdf:type pokemon:hasHeight dbpedia:hsvCoordinateHue pokemon:hasGenus pokemon:firmness pokemon:hasFlavor pokemon:isAbleToApply pokemon:inEggGroup dbpedia:rgbCoordinateBlue pokemon:smoothness pokemon:mayHaveHiddenAbility qudt:hasQuantityKind pokemon:hasCatchRate dbpedia:cmykCoordinateMagenta pokemon:hasSize pokemon:hasType pokemon:hasWeight pokemon:hasShape dbpedia:rgbCoordinateRed pokemon:hasColour foaf:depiction dbpedia:cmykCoordinateCyanic dbpedia:hsvCoordinateSaturation pokemon:mayHaveAbility dbpedia:hsvCoordinateLightness pokemon:effectDescription ) ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:description "A unique identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path linkml_common:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "A description of the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ] ;
    sh:targetClass owl:Thing .

foaf:Person a sh:NodeShape ;
    sh:closed true ;
    sh:description "A person is a human being" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A description of the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:anyURI ;
            sh:description "A unique identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path linkml_common:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable label for the entity" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "A depiction of the person" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path foaf:depiction ] ;
    sh:targetClass foaf:Person .

