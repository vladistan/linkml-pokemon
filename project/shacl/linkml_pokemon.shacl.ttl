@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix linkml_common: <https://w3id.org/linkml/common/> .
@prefix linkml_pokemon: <https://w3id.org/vladistan/linkml-pokemon/> .
@prefix pokemon: <https://pokemonkg.org/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pokemon:BattleItem a sh:NodeShape ;
    sh:closed true ;
    sh:description "Battle items are items that can be used during battles." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:BattleItem .

pokemon:Berry a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pokemon:hasSize ] ;
    sh:targetClass pokemon:Berry .

pokemon:Flavor a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:Flavor .

pokemon:Food a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type pokemon:hasSize ) ;
    sh:targetClass pokemon:Food .

pokemon:Game a sh:NodeShape ;
    sh:closed true ;
    sh:description "A game is a type of media that can be played by people." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:Game .

pokemon:Generation a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pokemon:Species ;
            sh:description "['A Pokedex entry features a species']" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path pokemon:featuresSpecies ] ;
    sh:targetClass pokemon:Generation .

pokemon:Gym a sh:NodeShape ;
    sh:closed true ;
    sh:description "A gym is a location that can be battled at." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:Gym .

pokemon:GymLeader a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:GymLeader .

pokemon:HM a sh:NodeShape ;
    sh:closed true ;
    sh:description "Hidden Machine" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:HM .

pokemon:HoldItem a sh:NodeShape ;
    sh:closed true ;
    sh:description "A hold item is an item that can be held by a Pokemon." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:HoldItem .

pokemon:Item a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type pokemon:hasSize ) ;
    sh:targetClass pokemon:Item .

pokemon:LearningByLevelingUp a sh:NodeShape ;
    sh:closed true ;
    sh:description "A move that is learned by leveling up." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:LearningByLevelingUp .

pokemon:LearningThroughBreeding a sh:NodeShape ;
    sh:closed true ;
    sh:description "A move that is learned by breeding." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:LearningThroughBreeding .

pokemon:Medicine a sh:NodeShape ;
    sh:closed true ;
    sh:description "Medicine items can heal various afflictions of a Pokemon." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:Medicine .

pokemon:MoveLearning a sh:NodeShape ;
    sh:closed true ;
    sh:description "A move learning is a way that a Pokemon can learn a move." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:MoveLearning .

pokemon:PhysicalMove a sh:NodeShape ;
    sh:closed true ;
    sh:description "A physical move is a type of move that can be used during battles." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pokemon:Type ;
            sh:description "['A Pokemon has a type']" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path pokemon:hasType ],
        [ sh:datatype xsd:string ;
            sh:description "A description of the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path linkml_common:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Unique human-readable label for the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "A description of the effect of the entity" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pokemon:effectDescription ] ;
    sh:targetClass pokemon:PhysicalMove .

pokemon:Place a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:Place .

pokemon:Pokeball a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:Pokeball .

pokemon:Pokedex a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:Pokedex .

pokemon:PokedexEntry a sh:NodeShape ;
    sh:closed true ;
    sh:description "A pokedex entry is a description of a Pokemon." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:PokedexEntry .

pokemon:Pokemon a sh:NodeShape ;
    sh:closed true ;
    sh:description "A Pokemon" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:Pokemon .

pokemon:Region a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:Region .

pokemon:SpecialMove a sh:NodeShape ;
    sh:closed true ;
    sh:description "A special move is a type of move that can be used during battles." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unique human-readable label for the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "A description of the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path rdfs:comment ],
        [ sh:class pokemon:Type ;
            sh:description "['A Pokemon has a type']" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path pokemon:hasType ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path linkml_common:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "A description of the effect of the entity" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pokemon:effectDescription ] ;
    sh:targetClass pokemon:SpecialMove .

pokemon:StatusMove a sh:NodeShape ;
    sh:closed true ;
    sh:description "A status move is a type of move that can be used during battles." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pokemon:Type ;
            sh:description "['A Pokemon has a type']" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path pokemon:hasType ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path linkml_common:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Unique human-readable label for the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "A description of the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:string ;
            sh:description "A description of the effect of the entity" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pokemon:effectDescription ] ;
    sh:targetClass pokemon:StatusMove .

pokemon:TM a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:TM .

pokemon:Town a sh:NodeShape ;
    sh:closed true ;
    sh:description "A town is a type of place that can be visited." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:Town .

pokemon:Trainer a sh:NodeShape ;
    sh:closed true ;
    sh:description "A trainer is a person who is able to catch Pokemon." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:Trainer .

linkml_pokemon:Entity a sh:NodeShape ;
    sh:closed true ;
    sh:description "A grouping of attributes that can be reffered to" ;
    sh:ignoredProperties ( rdf:type pokemon:effectDescription pokemon:hasType ) ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path linkml_common:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Unique human-readable label for the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "A description of the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:comment ] ;
    sh:targetClass linkml_pokemon:Entity .

linkml_pokemon:NamedThing a sh:NodeShape ;
    sh:closed true ;
    sh:description "A generic grouping for any identifiable entity that has a name" ;
    sh:ignoredProperties ( pokemon:hasHeight pokemon:isAbleToApply pokemon:hasShape pokemon:hasWeight pokemon:inEggGroup foaf:depiction rdf:type pokemon:hasCatchRate pokemon:hasColour pokemon:foundIn pokemon:hasType pokemon:hasGenus pokemon:mayHaveAbility pokemon:mayHaveHiddenAbility ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A description of the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:comment ],
        [ sh:datatype xsd:anyURI ;
            sh:description "A unique identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pokemon:id ],
        [ sh:datatype xsd:string ;
            sh:description "Unique human-readable label for the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ] ;
    sh:targetClass linkml_pokemon:NamedThing .

linkml_pokemon:Thing a sh:NodeShape ;
    sh:closed true ;
    sh:description "A generic grouping for any identifiable attributes with an id" ;
    sh:ignoredProperties ( rdfs:label pokemon:hasHeight pokemon:isAbleToApply pokemon:hasShape pokemon:hasWeight pokemon:inEggGroup foaf:depiction rdf:type pokemon:hasCatchRate rdfs:comment pokemon:hasColour pokemon:foundIn pokemon:hasType pokemon:hasGenus pokemon:mayHaveAbility pokemon:mayHaveHiddenAbility ) ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:description "A unique identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pokemon:id ] ;
    sh:targetClass linkml_pokemon:Thing .

pokemon:Colour a sh:NodeShape ;
    sh:closed true ;
    sh:description "Colors are categories that certain Pokemon belong to, which determine which Pokemon they can breed with." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:Colour .

pokemon:EggGroup a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:EggGroup .

pokemon:Habitat a sh:NodeShape ;
    sh:closed true ;
    sh:description "A habitat is a type of environment that certain Pokemon belong to." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:Habitat .

pokemon:Move a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A description of the effect of the entity" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pokemon:effectDescription ],
        [ sh:datatype xsd:string ;
            sh:description "A description of the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path rdfs:comment ],
        [ sh:class pokemon:Type ;
            sh:description "['A Pokemon has a type']" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path pokemon:hasType ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path linkml_common:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Unique human-readable label for the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:label ] ;
    sh:targetClass pokemon:Move .

pokemon:Shape a sh:NodeShape ;
    sh:closed true ;
    sh:description "Shapes are categories that certain Pokemon belong to, which determine which Pokemon they can breed with." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:Shape .

pokemon:Species a sh:NodeShape ;
    sh:closed true ;
    sh:description "A species is a category of Pokemon that share common features." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pokemon:Habitat ;
            sh:description "['A place is found in a location']" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path pokemon:foundIn ],
        [ sh:class pokemon:Type ;
            sh:description "['A Pokemon has a type']" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path pokemon:hasType ],
        [ sh:class pokemon:Ability ;
            sh:description "['A Pokemon may have an ability']" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path pokemon:mayHaveAbility ],
        [ sh:class pokemon:Colour ;
            sh:description "['A Pokemon has a color']" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path pokemon:hasColour ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pokemon:hasHeight ],
        [ sh:datatype xsd:string ;
            sh:description "A description of the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path rdfs:comment ],
        [ sh:class pokemon:EggGroup ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path pokemon:inEggGroup ],
        [ sh:class pokemon:Shape ;
            sh:description "The shape of a berry is a measure of how good it is for making a Potion." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path pokemon:hasShape ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path pokemon:hasGenus ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pokemon:hasWeight ],
        [ sh:class pokemon:Move ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path pokemon:isAbleToApply ],
        [ sh:class pokemon:Ability ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path pokemon:mayHaveHiddenAbility ],
        [ sh:datatype xsd:anyURI ;
            sh:description "A unique identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path pokemon:id ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path pokemon:hasCatchRate ],
        [ sh:datatype xsd:string ;
            sh:description "A depiction of the person" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path foaf:depiction ],
        [ sh:datatype xsd:string ;
            sh:description "Unique human-readable label for the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path rdfs:label ] ;
    sh:targetClass pokemon:Species .

pokemon:Ability a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path linkml_common:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Unique human-readable label for the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "A description of the effect of the entity" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pokemon:effectDescription ],
        [ sh:datatype xsd:string ;
            sh:description "A description of the entity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:comment ] ;
    sh:targetClass pokemon:Ability .

pokemon:Type a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass pokemon:Type .

