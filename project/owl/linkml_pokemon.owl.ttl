            owl:onProperty pokemon:applicableCGSUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:dimensionVectorForSI ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:iec61360Code ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:latexDefinition ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty pokemon:applicableISOUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty pokemon:qkdvDenominator ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:SystemOfQuantityKinds ;
            owl:onProperty qudt:belongsToSystemOfQuantities ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty pokemon:applicableUSCustomaryUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:applicableISOUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:QuantityKindDimensionVectorSI ;
            owl:onProperty pokemon:dimensionVectorForSI ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty pokemon:qkdvNumerator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:applicableImperialUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:mathMLdefinition ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty pokemon:applicableImperialUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:latexDefinition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasDimensionVector ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:applicableSIUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:QuantityKind ;
            owl:onProperty pokemon:exactMatch ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty pokemon:applicableSIUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:qkdvNumerator ],
        qudt:AbstractQuantityKind,
        qudt:Verifiable ;
    skos:definition "A <b>Quantity Kind</b> is any observable property that can be measured and quantified numerically. Familiar examples include physical properties such as length, mass, time, force, energy, power, electric charge, etc. Less familiar examples include currency, interest rate, price to earning ratio, and information capacity." ;
    skos:exactMatch qudt:QuantityKind ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> ;
    skos:note "A <b>Quantity Kind</b> is any observable property that can be  measured and quantified numerically. Familiar examples include physical properties such as length, mass, time, force, energy, power, electric charge, etc. Less familiar examples include currency, interest rate, price to earning ratio, and information capacity.^^rdf:HTML" .

qudt:QuantityKindDimensionVector a owl:Class ;
    rdfs:label "QuantityKindDimensionVector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pokemon:dimensionExponentForAmountOfSubstance ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:dimensionExponentForAmountOfSubstance ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:dimensionExponentForLuminousIntensity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:dimensionExponentForThermodynamicTemperature ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pokemon:dimensionExponentForElectricCurrent ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pokemon:dimensionExponentForLength ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pokemon:dimensionExponentForMass ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:QuantityKind ;
            owl:onProperty pokemon:hasReferenceQuantityKind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:latexDefinition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:dimensionExponentForElectricCurrent ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pokemon:dimensionExponentForTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:latexSymbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:dimensionExponentForMass ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pokemon:dimensionExponentForLuminousIntensity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:dimensionExponentForLength ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pokemon:dimensionExponentForThermodynamicTemperature ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:latexSymbol ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pokemon:dimensionlessExponent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:latexDefinition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:dimensionlessExponent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasReferenceQuantityKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:dimensionExponentForTime ],
        qudt:Concept ;
    skos:definition """<p class="lm-para">A  <em>Quantity Kind Dimension Vector</em> describes the dimensionality of a quantity kind in the context of a system of units. In the SI system of units, the dimensions of a quantity kind are expressed as a product of the basic physical dimensions mass ($M$), length ($L$), time ($T$) current ($I$), amount of substance ($N$), luminous intensity ($J$) and absolute temperature ($\\theta$) as $dim \\, Q = L^{\\alpha} \\, M^{\\beta} \\, T^{\\gamma} \\, I ^{\\delta} \\, \\theta ^{\\epsilon} \\, N^{\\eta} \\, J ^{\\nu}$.</p>

<p class="lm-para">The rational powers of the dimensional exponents, $\\alpha, \\, \\beta, \\, \\gamma, \\, \\delta, \\, \\epsilon, \\ , \\eta, \\, \\nu$, are positive, negative, or zero.</p>

<p class="lm-para">For example, the dimension of the physical quantity kind $\\it{speed}$ is $\\ boxed{length/time}$, $L/T$ or $LT^{-1}$, and the dimension of the physical quantity kind force is $\\boxed{mass \\times acceleration}$ or $\\boxed{mass \\times (length/time)/time}$, $ML/T^2$ or $MLT^{-2}$ respectively.</p>""" ;
    skos:exactMatch qudt:QuantityKindDimensionVector ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> ;
    skos:note """<p class=\\"lm-para\\">A  <em>Quantity Kind Dimension Vector</em> describes the dimensionality of a quantity kind in the context of a system of units. In the SI system of units, the dimensions of a quantity kind are expressed as a product of the basic physical dimensions mass ($M$), length ($L$), time ($T$) current ($I$), amount of substance ($N$), luminous intensity ($J$) and absolute temperature ($\\\\theta$) as $dim \\\\, Q = L^{\\\\alpha} \\\\, M^{\\\\beta} \\\\, T^{\\\\gamma} \\\\, I ^{\\\\delta} \\\\, \\\\theta ^{\\\\epsilon} \\\\ , N^{\\\\eta} \\\\, J ^{\\\\nu}$.</p>

<p class=\\"lm-para\\">The rational powers of the dimensional exponents, $\\\\alpha, \\\\, \\\\beta, \\\\, \\\\gamma, \\\\, \\\\delta, \\\\, \\\\epsilon, \\\\, \\\\eta, \\\\, \\\\nu$, are positive, negative, or zero.</p>

<p class=\\"lm-para\\">For example, the dimension of the physical quantity kind $\\\\it{speed}$ is $\\\\boxed{length/time}$, $L/T$ or $LT^{-1}$, and the dimension of the physical quantity kind force is $\\\\boxed{mass \\\\times acceleration}$ or $\\\\boxed{mass \\\\times (length/time)/time}$, $ML/T^2$ or $MLT^{-2}$ respectively.</p>^^rdf:HTML""" .

owl:NamedIndividual a owl:Class ;
