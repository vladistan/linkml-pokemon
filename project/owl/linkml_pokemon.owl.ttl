@prefix dbpedia: <http://dbpedia.org/ontology/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix pokemon: <https://pokemonkg.org/ontology#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

qudt:abbreviation a owl:DatatypeProperty ;
    rdfs:label "abbreviation" ;
    skos:definition "An abbreviation for a unit is a short ASCII string that is used in place of the full name for the unit in contexts where non-ASCII characters would be problematic, or where using the abbreviation will enhance readability. When a power of abase unit needs to be expressed, such as squares this can be done using abbreviations rather than symbols. For example, <em>sq ft</em> means <em>square foot</em>, and <em>cu ft</em> means <em>cubic foot</em>." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:altSymbol a owl:DatatypeProperty ;
    rdfs:label "altSymbol" ;
    rdfs:subPropertyOf qudt:literal ;
    skos:definition "An alternative symbol" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:ansiSQLName a owl:DatatypeProperty ;
    rdfs:label "ansiSQLName" ;
    rdfs:range xsd:string ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:applicableCGSUnit a owl:ObjectProperty ;
    rdfs:label "applicableCGSUnit" ;
    rdfs:range qudt:Unit ;
    rdfs:subPropertyOf qudt:applicableUnit ;
    skos:definition "applicable CGS unit" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:applicableISOUnit a owl:ObjectProperty ;
    rdfs:label "applicableISOUnit" ;
    rdfs:range qudt:Unit ;
    rdfs:subPropertyOf qudt:applicableUnit ;
    skos:definition "applicable ISO unit" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:applicableImperialUnit a owl:ObjectProperty ;
    rdfs:label "applicableImperialUnit" ;
    rdfs:range qudt:Unit ;
    rdfs:subPropertyOf qudt:applicableUnit ;
    skos:definition "applicable Imperial unit" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:applicablePhysicalConstant a owl:DatatypeProperty ;
    rdfs:label "applicablePhysicalConstant" ;
    skos:definition "applicable physical constant" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:applicableSIUnit a owl:ObjectProperty ;
    rdfs:label "applicableSIUnit" ;
    rdfs:range qudt:Unit ;
    rdfs:subPropertyOf qudt:applicableUnit ;
    skos:definition "applicable SI unit" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:applicableSystem a owl:DatatypeProperty ;
    rdfs:label "applicableSystem" ;
    skos:definition "This property relates a unit of measure with a unit system that may or may not define the unit, but within which the unit is compatible." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:applicableUSCustomaryUnit a owl:ObjectProperty ;
    rdfs:label "applicableUSCustomaryUnit" ;
    rdfs:range qudt:Unit ;
    rdfs:subPropertyOf qudt:applicableUnit ;
    skos:definition "applicable US Customary unit" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:baseDimensionEnumeration a owl:ObjectProperty ;
    rdfs:label "baseDimensionEnumeration" ;
    rdfs:range qudt:Enumeration ;
    skos:definition "This property associates a system of quantities with an enumeration that enumerates the base dimensions of the system in canonical order." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:basis a owl:DatatypeProperty ;
    rdfs:label "basis" ;
    skos:definition "basis" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:bitOrder a owl:ObjectProperty ;
    rdfs:label "bitOrder" ;
    rdfs:range qudt:EndianType ;
    skos:definition "bit order" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:bits a owl:DatatypeProperty ;
    rdfs:label "bits" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:bounded a owl:DatatypeProperty ;
    rdfs:label "bounded" ;
    skos:definition "bounded" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:byteOrder a owl:ObjectProperty ;
    rdfs:label "byteOrder" ;
    rdfs:range qudt:EndianType ;
    skos:definition "Byte order is an enumeration of two values: 'Big Endian' and 'Little Endian' and is used to denote whether the most signiticant byte is either first or last, respectively." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:bytes a owl:DatatypeProperty ;
    rdfs:label "bytes" ;
    skos:definition "bytes" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:cName a owl:DatatypeProperty ;
    rdfs:label "cName" ;
    rdfs:range xsd:string ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> ;
    skos:note "Datatype name in the C programming language" .

qudt:cardinality a owl:DatatypeProperty ;
    rdfs:label "cardinality" ;
    skos:definition "cardinality" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:conversionMultiplier a owl:DatatypeProperty ;
    rdfs:label "conversionMultiplier" ;
    skos:definition "conversion multiplier" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:conversionMultiplierSN a owl:DatatypeProperty ;
    rdfs:label "conversionMultiplierSN" ;
    skos:definition "conversion multiplier scientific" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:conversionOffset a owl:DatatypeProperty ;
    rdfs:label "conversionOffset" ;
    skos:definition "conversion offset" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:conversionOffsetSN a owl:DatatypeProperty ;
    rdfs:label "conversionOffsetSN" ;
    skos:definition "conversion offset scientific" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:dataEncoding a owl:ObjectProperty ;
    rdfs:label "dataEncoding" ;
    rdfs:range qudt:DataEncoding ;
    skos:definition "data encoding" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:datatype a owl:DatatypeProperty ;
    rdfs:label "datatype" ;
    skos:definition "datatype" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:dbpediaMatch a owl:DatatypeProperty ;
    rdfs:label "dbpediaMatch" ;
    rdfs:range xsd:anyURI ;
    skos:definition "dbpedia match" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:default a owl:DatatypeProperty ;
    rdfs:label "default" ;
    skos:definition "The default element in an enumeration" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:deprecated a owl:DatatypeProperty ;
    rdfs:label "deprecated" ;
    skos:definition "deprecated" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:derivedCoherentUnitOfSystem a owl:DatatypeProperty ;
    rdfs:label "derivedCoherentUnitOfSystem" ;
    rdfs:subPropertyOf qudt:definedUnitOfSystem,
        qudt:derivedUnitOfSystem ;
    skos:definition "This property relates a unit of measure to the unit system in which the unit is derived from the system's base units with a proportionality constant of one." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:dimensionExponentForAmountOfSubstance a owl:DatatypeProperty ;
    rdfs:label "dimensionExponentForAmountOfSubstance" ;
    skos:definition "dimension exponent for amount of substance" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:dimensionExponentForElectricCurrent a owl:DatatypeProperty ;
    rdfs:label "dimensionExponentForElectricCurrent" ;
    skos:definition "dimension exponent for electric current" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:dimensionExponentForLength a owl:DatatypeProperty ;
    rdfs:label "dimensionExponentForLength" ;
    skos:definition "dimension exponent for length" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:dimensionExponentForLuminousIntensity a owl:DatatypeProperty ;
    rdfs:label "dimensionExponentForLuminousIntensity" ;
    skos:definition "dimension exponent for luminous intensity" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:dimensionExponentForMass a owl:DatatypeProperty ;
    rdfs:label "dimensionExponentForMass" ;
    skos:definition "dimension exponent for mass" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:dimensionExponentForThermodynamicTemperature a owl:DatatypeProperty ;
    rdfs:label "dimensionExponentForThermodynamicTemperature" ;
    skos:definition "dimension exponent for thermodynamic temperature" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:dimensionExponentForTime a owl:DatatypeProperty ;
    rdfs:label "dimensionExponentForTime" ;
    skos:definition "dimension exponent for time" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:dimensionVectorForSI a owl:ObjectProperty ;
    rdfs:label "dimensionVectorForSI" ;
    rdfs:range qudt:QuantityKindDimensionVectorSI ;
    skos:definition "dimension vector for SI" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:dimensionlessExponent a owl:DatatypeProperty ;
    rdfs:label "dimensionlessExponent" ;
    skos:definition "dimensionless exponent" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:element a owl:DatatypeProperty ;
    rdfs:label "element" ;
    skos:definition "An element of an enumeration" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:encoding a owl:DatatypeProperty ;
    rdfs:label "encoding" ;
    skos:definition "encoding" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:exactConstant a owl:DatatypeProperty ;
    rdfs:label "exactConstant" ;
    skos:definition "exact constant" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:exactMatch a owl:DatatypeProperty ;
    rdfs:label "exactMatch" ;
    skos:definition "exact match" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:factorUnitScalar a owl:DatatypeProperty ;
    rdfs:label "factorUnitScalar" ;
    skos:definition "For a derived unit that is not exactly the product of its factor units, this property defines the scalar with which that product has to be multiplied with." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:hasAllowedUnit a owl:ObjectProperty ;
    rdfs:label "hasAllowedUnit" ;
    rdfs:range qudt:Unit ;
    rdfs:subPropertyOf qudt:hasUnit ;
    skos:definition "This property relates a unit system with a unit of measure that is not defined by or part of the system, but is allowed for use within the system. An allowed unit must be convertible to some dimensionally eqiuvalent unit that is defined by the system." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:hasBaseQuantityKind a owl:DatatypeProperty ;
    rdfs:label "hasBaseQuantityKind" ;
    rdfs:subPropertyOf qudt:hasQuantityKind ;
    skos:definition "has base quantity kind" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:hasBaseUnit a owl:DatatypeProperty ;
    rdfs:label "hasBaseUnit" ;
    rdfs:subPropertyOf qudt:hasCoherentUnit ;
    skos:definition "This property relates a system of units to a base unit defined within the system. The base units of a system are used to define the derived units of the system by expressing the derived units as products of the base units raised to a rational power." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:hasDerivedCoherentUnit a owl:DatatypeProperty ;
    rdfs:label "hasDerivedCoherentUnit" ;
    rdfs:subPropertyOf qudt:hasCoherentUnit,
        qudt:hasDerivedUnit ;
    skos:definition "derived coherent unit" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:hasDimensionVector a owl:ObjectProperty ;
    rdfs:label "hasDimensionVector" ;
    rdfs:range qudt:QuantityKindDimensionVector ;
    skos:definition "has dimension vector" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:hasFactorUnit a owl:DatatypeProperty ;
    rdfs:label "hasFactorUnit" ;
    skos:definition "This property relates a derived unit to one of its constituent factor units" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:hasReferenceQuantityKind a owl:DatatypeProperty ;
    rdfs:label "hasReferenceQuantityKind" ;
    skos:definition "has reference quantity kind" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:hasRule a owl:DatatypeProperty ;
    rdfs:label "hasRule" ;
    skos:definition "has rule" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:hasUnitSystem a owl:DatatypeProperty ;
    rdfs:label "hasUnitSystem" ;
    skos:definition "has unit system" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:iec61360Code a owl:DatatypeProperty ;
    rdfs:label "iec61360Code" ;
    skos:definition "iec-61360 code" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:isDeltaQuantity a owl:DatatypeProperty ;
    rdfs:label "isDeltaQuantity" ;
    skos:definition "This property is used to identify a Quantity instance that is a measure of a change, or interval, of some property, rather than a measure of its absolute value. This is important for measurements such as temperature differences where the conversion among units would be calculated differently because of offsets." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> ;
    skos:note "This property is used to identify a Quantity instance that is a measure of a change, or interval, of some property, rather than a measure of its absolute value. This is important for measurements such as temperature differences where the conversion among units would be calculated differently because of offsets." .

qudt:isReplacedBy a owl:DatatypeProperty ;
    rdfs:label "isReplacedBy" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:isoNormativeReference a owl:DatatypeProperty ;
    rdfs:label "isoNormativeReference" ;
    rdfs:subPropertyOf qudt:normativeReference ;
    skos:definition "Provides a way to reference the ISO unit definition." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:javaName a owl:DatatypeProperty ;
    rdfs:label "javaName" ;
    skos:definition "java name" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:jsName a owl:DatatypeProperty ;
    rdfs:label "jsName" ;
    skos:definition "Javascript name" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:latexDefinition a owl:DatatypeProperty ;
    rdfs:label "latexDefinition" ;
    skos:definition "latex definition" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:latexSymbol a owl:DatatypeProperty ;
    rdfs:label "latexSymbol" ;
    skos:definition """
  The symbol is a glyph that is used to represent some concept, typically a unit or a quantity, in a compact form.
  For example, the symbol for an Ohm is $ohm$.
  This contrasts with 'unit:abbreviation', which gives a short alphanumeric abbreviation for the unit, 'ohm' for Ohm.
  """ ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:mathMLdefinition a owl:DatatypeProperty ;
    rdfs:label "mathMLdefinition" ;
    rdfs:subPropertyOf qudt:mathDefinition ;
    skos:definition "mathML definition" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:matlabName a owl:DatatypeProperty ;
    rdfs:label "matlabName" ;
    skos:definition "matlab name" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:microsoftSQLServerName a owl:DatatypeProperty ;
    rdfs:label "microsoftSQLServerName" ;
    skos:definition "Microsoft SQL Server name" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:mySQLName a owl:DatatypeProperty ;
    rdfs:label "mySQLName" ;
    skos:definition "MySQL name" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:odbcName a owl:DatatypeProperty ;
    rdfs:label "odbcName" ;
    skos:definition "ODBC name" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:oleDBName a owl:DatatypeProperty ;
    rdfs:label "oleDBName" ;
    skos:definition "OLE DB (Object Linking and Embedding, Database, sometimes written as OLEDB or OLE-DB), an API designed by Microsoft, allows accessing data from a variety of sources in a uniform manner. The API provides a set of interfaces implemented using the Component Object Model (COM); it is otherwise unrelated to OLE. " ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:oracleSQLName a owl:DatatypeProperty ;
    rdfs:label "oracleSQLName" ;
    rdfs:range xsd:string ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:orderedType a owl:DatatypeProperty ;
    rdfs:label "orderedType" ;
    skos:definition "ordered type" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:plainTextDescription a owl:DatatypeProperty ;
    rdfs:label "plainTextDescription" ;
    skos:definition "A plain text description is used to provide a description with only simple ASCII characters for cases where LaTeX , HTML or other markup would not be appropriate." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:prefix a owl:ObjectProperty ;
    rdfs:label "prefix" ;
    rdfs:range qudt:Prefix ;
    skos:definition "Associates a unit with the appropriate prefix, if any." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> ;
    skos:note "Associates a unit with the appropriate prefix, if any." .

qudt:prefixMultiplier a owl:DatatypeProperty ;
    rdfs:label "prefixMultiplier" ;
    skos:definition "prefix multiplier" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:protocolBuffersName a owl:DatatypeProperty ;
    rdfs:label "protocolBuffersName" ;
    rdfs:range xsd:string ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:pythonName a owl:DatatypeProperty ;
    rdfs:label "pythonName" ;
    rdfs:range xsd:string ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:qkdvDenominator a owl:ObjectProperty ;
    rdfs:label "qkdvDenominator" ;
    rdfs:range qudt:QuantityKindDimensionVector ;
    skos:definition "denominator dimension vector" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:qkdvNumerator a owl:ObjectProperty ;
    rdfs:label "qkdvNumerator" ;
    rdfs:range qudt:QuantityKindDimensionVector ;
    skos:definition "numerator dimension vector" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:quantityValue a owl:ObjectProperty ;
    rdfs:label "quantityValue" ;
    rdfs:range qudt:QuantityValue ;
    skos:definition "quantity value" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:qudt_description a owl:DatatypeProperty ;
    rdfs:label "qudt_description" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:qudt_value a owl:DatatypeProperty ;
    rdfs:label "qudt_value" ;
    skos:definition "A property to relate an observable thing with a value of any kind" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:rationale a owl:DatatypeProperty ;
    rdfs:label "rationale" ;
    rdfs:range xsd:string ;
    skos:definition "rationale" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:relativeStandardUncertainty a owl:DatatypeProperty ;
    rdfs:label "relativeStandardUncertainty" ;
    skos:definition "The relative standard uncertainty of a measurement is the (absolute) standard uncertainty divided by the magnitude of the exact value." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:ruleType a owl:DatatypeProperty ;
    rdfs:label "ruleType" ;
    skos:definition "rule type" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:scalingOf a owl:DatatypeProperty ;
    rdfs:label "scalingOf" ;
    skos:definition "This property relates a unit to another unit it is scaled from" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:siUnitsExpression a owl:DatatypeProperty ;
    rdfs:label "siUnitsExpression" ;
    skos:definition "si units expression" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:standardUncertainty a owl:DatatypeProperty ;
    rdfs:label "standardUncertainty" ;
    skos:definition "The standard uncertainty of a quantity is the estimated standard deviation of the mean taken from a series of measurements." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:standardUncertaintySN a owl:DatatypeProperty ;
    rdfs:label "standardUncertaintySN" ;
    skos:definition "The standard uncertainty of a quantity is the estimated standard deviation of the mean taken from a series of measurements." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:symbol a owl:DatatypeProperty ;
    rdfs:label "symbol" ;
    rdfs:subPropertyOf qudt:literal ;
    skos:definition """
  The symbol is a glyph that is used to represent some concept, typically a unit or a quantity, in a compact form.
  For example, the symbol for an Ohm is $ohm$.
  This contrasts with 'unit:abbreviation', which gives a short alphanumeric abbreviation for the unit, 'ohm' for Ohm.
  """ ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:systemDerivedQuantityKind a owl:DatatypeProperty ;
    rdfs:label "systemDerivedQuantityKind" ;
    rdfs:subPropertyOf qudt:hasQuantityKind ;
    skos:definition "system derived quantity kind" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:ucumCode a owl:DatatypeProperty ;
    rdfs:label "ucumCode" ;
    skos:definition "<p><em>ucumCode</em> associates a QUDT unit with its UCUM code (case-sensitive). </p><p>In SHACL the values are derived from specific ucum properties using 'sh:values'.</p>" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:udunitsCode a owl:DatatypeProperty ;
    rdfs:label "udunitsCode" ;
    skos:definition "The UDUNITS package supports units of physical quantities. Its C library provides for arithmetic manipulation of units and for conversion of numeric values between compatible units. The package contains an extensive unit database, which is in XML format and user-extendable. The package also contains a command-line utility for investigating units and converting values." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:uneceCommonCode a owl:DatatypeProperty ;
    rdfs:label "uneceCommonCode" ;
    skos:definition "The UN/CEFACT Recommendation 20 provides three character alphabetic and alphanumeric codes for representing units of measurement for length, area, volume/capacity, mass (weight), time, and other quantities used in international trade. The codes are intended for use in manual and/or automated systems for the exchange of information between participants in international trade." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:valueSN a owl:DatatypeProperty ;
    rdfs:label "valueSN" ;
    skos:definition "A property to relate an observable thing with a value of any kind" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:vbName a owl:DatatypeProperty ;
    rdfs:label "vbName" ;
    rdfs:range xsd:string ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:wikidataMatch a owl:DatatypeProperty ;
    rdfs:label "wikidataMatch" ;
    rdfs:range xsd:anyURI ;
    skos:definition "wikidata match" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

pokemon:BattleItem a owl:Class ;
    rdfs:label "BattleItem" ;
    rdfs:subClassOf pokemon:Item ;
    skos:definition "Battle items are items that can be used during battles." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Berry a owl:Class ;
    rdfs:label "Berry" ;
    rdfs:comment "Berries are small, juicy, fleshy fruit. As in the real world, a large variety exists in the Pokémon world, with a large range of flavors, names, and effects. First found in the Generation II games, many Berries have since became critical help items in battle, where their various effects include HP and status condition restoration, stat enhancement, and even damage negation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:hasSize ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:hasSize ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:hasSize ],
        pokemon:Food ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Game a owl:Class ;
    rdfs:label "Game" ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "A game is a type of media that can be played by people." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Generation a owl:Class ;
    rdfs:label "Generation" ;
    rdfs:comment "Generations refers to the Pokemon game series. It is a group of games that were released at or around the same time. It also means that games in the same generation are compatible with the others, containing the same Pokemon and the number of moves there are to be learned." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:featuresSpecies ],
        [ a owl:Restriction ;
            owl:allValuesFrom pokemon:Species ;
            owl:onProperty pokemon:featuresSpecies ],
        owl:Thing ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Gym a owl:Class ;
    rdfs:label "Gym" ;
    rdfs:subClassOf pokemon:Place ;
    skos:definition "A gym is a location that can be battled at." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:GymLeader a owl:Class ;
    rdfs:label "GymLeader" ;
    rdfs:comment "A gym leader is the highest ranking member and owner of an official Pokémon gym. Gym leaders use their gym and their Pokemon to test the skills of trainers that challenge them, and if said trainers win a battle, the gym leader will gift them a badge that's unique to that specific gym." ;
    rdfs:subClassOf pokemon:Trainer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:HM a owl:Class ;
    rdfs:label "HM" ;
    rdfs:subClassOf pokemon:Item ;
    skos:definition "Hidden Machine" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:HoldItem a owl:Class ;
    rdfs:label "HoldItem" ;
    rdfs:subClassOf pokemon:Item ;
    skos:definition "A hold item is an item that can be held by a Pokemon." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:LearningByLevelingUp a owl:Class ;
    rdfs:label "LearningByLevelingUp" ;
    rdfs:subClassOf pokemon:MoveLearning ;
    skos:definition "A move that is learned by leveling up." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:LearningThroughBreeding a owl:Class ;
    rdfs:label "LearningThroughBreeding" ;
    rdfs:subClassOf pokemon:MoveLearning ;
    skos:definition "A move that is learned by breeding." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Medicine a owl:Class ;
    rdfs:label "Medicine" ;
    rdfs:subClassOf pokemon:Item ;
    skos:definition "Medicine items can heal various afflictions of a Pokemon." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:PhysicalMove a owl:Class ;
    rdfs:label "PhysicalMove" ;
    rdfs:subClassOf pokemon:Move ;
    skos:definition "A physical move is a type of move that can be used during battles." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Pokeball a owl:Class ;
    rdfs:label "Pokeball" ;
    rdfs:comment "A Poké Ball is a type of item that is critical to a Trainer's quest, used for catching and storing Pokémon." ;
    rdfs:subClassOf pokemon:Item ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Pokemon a owl:Class ;
    rdfs:label "Pokemon" ;
    rdfs:seeAlso "<https://dbpedia.org/resource/Pokémon>" ;
    skos:definition "A Pokemon" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "Regions are areas in the Pokémon universe that are smaller parts of a nation." ;
    rdfs:subClassOf pokemon:Place ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:SpecialMove a owl:Class ;
    rdfs:label "SpecialMove" ;
    rdfs:subClassOf pokemon:Move ;
    skos:definition "A special move is a type of move that can be used during battles." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:StatusMove a owl:Class ;
    rdfs:label "StatusMove" ;
    rdfs:subClassOf pokemon:Move ;
    skos:definition "A status move is a type of move that can be used during battles." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:TM a owl:Class ;
    rdfs:label "TM" ;
    rdfs:comment "A Technical Machine is an item that can be used to teach a Pokemon a move." ;
    rdfs:subClassOf pokemon:Item,
        pokemon:MoveLearning ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Town a owl:Class ;
    rdfs:label "Town" ;
    rdfs:subClassOf pokemon:Place ;
    skos:definition "A town is a type of place that can be visited." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:accuracy a owl:DatatypeProperty ;
    rdfs:label "accuracy" ;
    rdfs:domain pokemon:Move ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:basePower a owl:DatatypeProperty ;
    rdfs:label "basePower" ;
    rdfs:domain pokemon:Move ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:basePowerPoints a owl:DatatypeProperty ;
    rdfs:label "basePowerPoints" ;
    rdfs:domain pokemon:Move ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:containsPlace a owl:AsymmetricProperty,
        owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "containsPlace" ;
    rdfs:comment "A place is contained to some extent in this place." ;
    rdfs:domain pokemon:Place ;
    rdfs:range pokemon:Place ;
    owl:inverseOf pokemon:locatedIn ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:describedInPokedex a owl:ObjectProperty ;
    rdfs:label "describedInPokedex" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:PokedexEntry ;
    owl:inverseOf pokemon:describesPokemon ;
    skos:definition "['A Pokedex entry is described in a Pokedex']" ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:entryNumber a owl:DatatypeProperty ;
    rdfs:label "entryNumber" ;
    rdfs:domain pokemon:PokedexEntry ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasPokedexEntry a owl:ObjectProperty ;
    rdfs:label "hasPokedexEntry" ;
    rdfs:comment "A Pokedex entry in which this Pokemon is described." ;
    rdfs:domain pokemon:Pokedex ;
    rdfs:range pokemon:PokedexEntry ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:learnsMove a owl:ObjectProperty ;
    rdfs:label "learnsMove" ;
    rdfs:domain pokemon:MoveLearning ;
    rdfs:range pokemon:Move ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:maxPowerPoints a owl:DatatypeProperty ;
    rdfs:label "maxPowerPoints" ;
    rdfs:domain pokemon:Move ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:minLevelToLearn a owl:DatatypeProperty ;
    rdfs:label "minLevelToLearn" ;
    rdfs:range xsd:integer ;
    skos:inScheme <https://pokemonkg.org/ontology> .

<https://pokemonkg.org/ontology.owl.ttl> a owl:Ontology ;
    rdfs:label "linkml-pokemon" ;
    dcterms:description "Ontology covering the Pokemon world as it is presented in games and anime television series." ;
    dcterms:issued "2019-07-27^^xsd:date" ;
    dcterms:license "MIT" ;
    dcterms:title "Pokemon Ontology" ;
    pav:createdOn "2019-07-27T00:00:00" ;
    rdfs:seeAlso <https://vladistan.github.io/linkml-pokemon> ;
    skos:definition "Ontology covering the Pokémon world as it is presented in games and anime television series" .

qudt:UCUMcs a owl:Class ;
    rdfs:label "UCUMcs" ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "Lexical pattern for the case-sensitive version of UCUM code" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> ;
    skos:note "Lexical pattern for the case-sensitive version of UCUM code" .

qudt:UCUMcs-term a owl:Class ;
    rdfs:label "UCUMcs-term" ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "Lexical pattern for the terminal symbols in the case-sensitive version of UCUM code" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> ;
    skos:note "Lexical pattern for the terminal symbols in the case-sensitive version of UCUM code" .

qudt:definedUnitOfSystem a owl:DatatypeProperty ;
    rdfs:label "definedUnitOfSystem" ;
    rdfs:subPropertyOf qudt:isUnitOfSystem ;
    skos:definition "This property relates a unit of measure with the unit system that defines the unit." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:derivedUnitOfSystem a owl:DatatypeProperty ;
    rdfs:label "derivedUnitOfSystem" ;
    rdfs:subPropertyOf qudt:isUnitOfSystem ;
    skos:definition "This property relates a unit of measure to the system of units in which it is defined as a derived unit. That is, the derived unit is defined as a product of the base units for the system raised to some rational power." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:hasDefinedUnit a owl:ObjectProperty ;
    rdfs:label "hasDefinedUnit" ;
    rdfs:range qudt:Unit ;
    rdfs:subPropertyOf qudt:hasUnit ;
    skos:definition "This property relates a unit system with a unit of measure that is defined by the system." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:hasDerivedUnit a owl:DatatypeProperty ;
    rdfs:label "hasDerivedUnit" ;
    skos:definition "This property relates a system of units to a unit of measure that is defined within the system in terms of the base units for the system. That is, the derived unit is defined as a product of the base units for the system raised to some rational power." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:mathDefinition a owl:DatatypeProperty ;
    rdfs:label "mathDefinition" ;
    skos:definition "math definition" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:normativeReference a owl:DatatypeProperty ;
    rdfs:label "normativeReference" ;
    skos:definition "Provides a way to reference information that is an authoritative source providing a standard definition" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

pokemon:Pokedex a owl:Class ;
    rdfs:label "Pokedex" ;
    rdfs:comment "The Pokedex is an electronic device designed to catalogue and provide information regarding the various species of Pokemon featured in the Pokemon video game, anime and manga series." ;
    rdfs:subClassOf owl:Thing ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:Trainer a owl:Class ;
    rdfs:label "Trainer" ;
    rdfs:subClassOf foaf:Person ;
    skos:definition "A trainer is a person who is able to catch Pokemon." ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:describesPokemon a owl:ObjectProperty ;
    rdfs:label "describesPokemon" ;
    rdfs:comment "A Pokemon that is described by this Pokedex entry." ;
    rdfs:domain pokemon:PokedexEntry ;
    rdfs:range pokemon:Species ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:evolvesFrom a owl:ObjectProperty ;
    rdfs:label "evolvesFrom" ;
    rdfs:comment "This species evolves the other species." ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Species ;
    owl:inverseOf pokemon:evolvesTo ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:evolvesTo a owl:ObjectProperty ;
    rdfs:label "evolvesTo" ;
    rdfs:comment "A Pokemon evolves to another Pokemon." ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Species ;
    owl:inverseOf pokemon:evolvesFrom ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:locatedIn a owl:AsymmetricProperty,
        owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "locatedIn" ;
    rdfs:comment "This place is located to some extent in another place." ;
    rdfs:domain pokemon:Place ;
    rdfs:range pokemon:Place ;
    skos:inScheme <https://pokemonkg.org/ontology> .

qudt:AbstractQuantityKind a owl:Class ;
    rdfs:label "AbstractQuantityKind" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:altSymbol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:broader ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pokemon:broader ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:symbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:symbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:QuantityKind ;
            owl:onProperty pokemon:broader ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:latexSymbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:altSymbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:latexSymbol ],
        qudt:Concept ;
    skos:definition "Quantity Kind (abstract)" ;
    skos:exactMatch qudt:AbstractQuantityKind ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:CardinalityType a owl:Class ;
    rdfs:label "CardinalityType" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:literal ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:literal ],
        qudt:EnumeratedValue ;
    skos:definition """
  In mathematics, the cardinality of a set is a measure of the number of elements of the set.
  For example, the set $A = {2, 4, 6}$ contains 3 elements, and therefore $A$ has a cardinality of 3.
  There are two approaches to cardinality: one which compares sets directly using bijections and injections,
   and another which uses cardinal numbers.
  """ ;
    skos:exactMatch qudt:CardinalityType ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:Datatype a owl:Class ;
    rdfs:label "Datatype" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:mySQLName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:qudt_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:oleDBName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:basis ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:cName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:mySQLName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:cardinality ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:pythonName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:javaName ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:Datatype ;
            owl:onProperty pokemon:basis ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:oracleSQLName ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:OrderedType ;
            owl:onProperty pokemon:orderedType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:oracleSQLName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:ansiSQLName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:qudt_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:matlabName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:microsoftSQLServerName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:vbName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:protocolBuffersName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:cName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:jsName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:bounded ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:protocolBuffersName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:bounded ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:odbcName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:javaName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:pythonName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:ansiSQLName ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:CardinalityType ;
            owl:onProperty pokemon:cardinality ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:microsoftSQLServerName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:vbName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:odbcName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:jsName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:matlabName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:oleDBName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:orderedType ],
        qudt:Concept ;
    skos:definition """
   <p>A <em>Datatype</em> is a definition of the type of the "value" of a data item (for example, "all integers between 0 and 10"),
   and the allowable operations on those values; the meaning of the data; and the way values of that type can be stored.
  Some types are primitive - built-in to the language, with no visible internal structure.
  For example "Boolean"; others are composite - constructed from one or more other types (of either kind).
  For example lists, arrays, structures, unions.
  Some languages provide strong typing, others allow implicit type conversion and/or explicit type conversion.
  </p>""" ;
    skos:exactMatch rdfs:Datatype ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:Encoding a owl:Class ;
    rdfs:label "Encoding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:bytes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:bits ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:bits ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:bytes ],
        qudt:Concept ;
    skos:definition "An encoding is a rule or algorithm that is used to convert data from a native, or unspecified form into a specific form that satisfies the encoding rules. Examples of encodings include character encodings, such as UTF-8." ;
    skos:exactMatch qudt:Encoding ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:OrderedType a owl:Class ;
    rdfs:label "OrderedType" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:literal ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:literal ],
        qudt:EnumeratedValue ;
    skos:definition "Describes how a data or information structure is ordered." ;
    skos:exactMatch qudt:OrderedType ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:QuantityKindDimensionVectorSI a owl:Class ;
    rdfs:label "QuantityKindDimensionVector_SI" ;
    rdfs:subClassOf qudt:QuantityKindDimensionVector ;
    skos:definition "Quantity Kind Dimension vector (SI)" ;
    skos:exactMatch qudt:QuantityKindDimensionVector_SI ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:Rule a owl:Class ;
    rdfs:label "Rule" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:rationale ],
        [ a owl:Restriction ;
            owl:allValuesFrom qudt:RuleType ;
            owl:onProperty pokemon:ruleType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pokemon:rationale ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pokemon:ruleType ],
        qudt:Concept,
        qudt:Verifiable ;
    skos:definition "Rule" ;
    skos:exactMatch qudt:Rule ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:RuleType a owl:Class ;
    rdfs:label "RuleType" ;
    rdfs:subClassOf qudt:EnumeratedValue ;
    skos:definition "Rule Type" ;
    skos:exactMatch qudt:RuleType ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:belongsToSystemOfQuantities a owl:ObjectProperty ;
    rdfs:label "belongsToSystemOfQuantities" ;
    rdfs:range qudt:SystemOfQuantityKinds ;
    skos:definition "belongs to system of quantities" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:guidance a owl:DatatypeProperty ;
    rdfs:label "guidance" ;
    rdfs:range xsd:string ;
    skos:definition "guidance" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:hasCoherentUnit a owl:DatatypeProperty ;
    rdfs:label "hasCoherentUnit" ;
    rdfs:subPropertyOf qudt:hasDefinedUnit ;
    skos:definition "A coherent unit of measurement for a unit system is a defined unit that may be expressed as a product of powers of the system's base units with the proportionality factor of one." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:hasQuantityKind a owl:ObjectProperty ;
    rdfs:label "hasQuantityKind" ;
    rdfs:range qudt:QuantityKind ;
    skos:definition "has quantity kind" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:hasReciprocalUnit a owl:ObjectProperty ;
    rdfs:label "hasReciprocalUnit" ;
    rdfs:range qudt:Unit ;
    skos:definition "has reciprocal unit" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:hasUnit a owl:ObjectProperty ;
    rdfs:label "hasUnit" ;
    rdfs:range qudt:Unit ;
    skos:definition "This property relates a factor unit to its unit or a system of units with a unit of measure that is either a) defined by the system, or b) accepted for use by the system and is convertible to a unit of equivalent dimension that is defined by the system. Systems of units may distinguish between base and derived units. Base units are the units which measure the base quantities for the corresponding system of quantities. The base units are used to define units for all other quantities as products of powers of the base units. Such units are called derived units for the system." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:literal a owl:DatatypeProperty ;
    rdfs:label "literal" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:omUnit a owl:DatatypeProperty ;
    rdfs:label "omUnit" ;
    skos:definition "om unit" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:qudt_id a owl:DatatypeProperty ;
    rdfs:label "qudt_id" ;
    skos:definition "The \"qudt:id\" is an identifier string that uniquely identifies a QUDT concept.  The identifier is constructed using a prefix. For example, units are coded using the pattern: \"UCCCENNNN\", where \"CCC\" is a numeric code or a category and \"NNNN\" is a digit string for a member element of that category. For scaled units there may be an addition field that has the format \"QNN\" where \"NN\" is a digit string representing an exponent power, and \"Q\" is a qualifier that indicates with the code \"P\" that the power is a positive decimal exponent, or the code \"N\" for a negative decimal exponent, or the code \"B\" for binary positive exponents." ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

qudt:unitFor a owl:DatatypeProperty ;
    rdfs:label "unitFor" ;
    skos:definition "unit for" ;
    skos:inScheme <http://qudt.org/subset/qudt_subset> .

foaf:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty foaf:depiction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty foaf:depiction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty foaf:depiction ],
        owl:NamedIndividual ;
    skos:definition "A person is a human being" ;
    skos:exactMatch foaf:Person ;
    skos:inScheme foaf: .

<https://dbpedia.org/ontology/Colour> a owl:Class ;
    rdfs:label "Colour" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://dbpedia.org/ontology/green> ],
