@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pokemon: <https://pokemonkg.org/ontology#> .

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@base <https://pokemonkg.org/ontology#> .

#################################################################
#    Annotation properties
#################################################################

# http://creativecommons.org/ns#attributionName
<http://creativecommons.org/ns#attributionName> a owl:AnnotationProperty .


# http://creativecommons.org/ns#attributionURL
<http://creativecommons.org/ns#attributionURL> a owl:AnnotationProperty .


# http://creativecommons.org/ns#license
<http://creativecommons.org/ns#license> a owl:AnnotationProperty .


# http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> a owl:AnnotationProperty .


# http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> a owl:AnnotationProperty .


# http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> a owl:AnnotationProperty .


# http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> a owl:AnnotationProperty .


# http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> a owl:AnnotationProperty .


# http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> a owl:AnnotationProperty .


# http://purl.org/ontology/bibo/status
<http://purl.org/ontology/bibo/status> a owl:AnnotationProperty .


# http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> a owl:AnnotationProperty .


# http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> a owl:AnnotationProperty .


# http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> a owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

# http://www.w3.org/2001/XMLSchema#date
xsd:date a rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################








pokemon:featuresSpecies a owl:ObjectProperty ;
                 rdfs:label "features Species" ;
                 rdfs:range pokemon:Species ;
                 owl:propertyChainAxiom (pokemon:hasPokédexEntry
                                         pokemon:describesPokémon
                                        ) ;
    skos:inScheme <https://pokemonkg.org/ontology> .


pokemon:foundIn a owl:ObjectProperty ;
    rdfs:label "found in" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Habitat ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasColour a owl:ObjectProperty ;
    rdfs:label "has colour" ;
    rdfs:range <http://dbpedia.org/ontology/Colour> ;
    skos:inScheme <https://pokemonkg.org/ontology> .



pokemon:inEggGroup a owl:ObjectProperty ;
    rdfs:label "in egg group" ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:EggGroup ;
    skos:inScheme <https://pokemonkg.org/ontology> .



pokemon:mayHaveAbility a owl:ObjectProperty ;
    rdfs:label "may have ability" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Ability ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:mayHaveHiddenAbility a owl:ObjectProperty ;
    rdfs:subPropertyOf pokemon:mayHaveAbility ;
    rdfs:label "may have hidden ability" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Ability .


# https://pokemonkg.org/ontology#learnsMove
pokemon:learnsMove a owl:ObjectProperty ;
            rdfs:domain pokemon:MoveLearning ;
            rdfs:range pokemon:Move ;
            rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
            rdfs:label "learns move" ,
                       "lernt Aktion"@de .


# https://pokemonkg.org/ontology#locatedIn
pokemon:locatedIn a owl:ObjectProperty ,
                    owl:AsymmetricProperty ,
                    owl:TransitiveProperty ;
           rdfs:domain pokemon:Place ;
           rdfs:range pokemon:Place ;
           rdfs:comment "Dieser Ort befindet sich in einem gewissen Maße in einem anderen Ort."@de ,
                        "This place is located to some extent in another place." ;
           rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
           rdfs:label "enthalten in"@de ,
                      "located in" .


# https://pokemonkg.org/ontology#hasFlavor
pokemon:hasFlavor a owl:ObjectProperty ;
           rdfs:domain pokemon:Food ;
           rdfs:range pokemon:Flavor ;
           rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
           rdfs:label "has flavor" ,
                      "hat Geschmacksrichtung"@de .


# https://pokemonkg.org/ontology#hasPokédexEntry
pokemon:hasPokédexEntry a owl:ObjectProperty ,
                          owl:InverseFunctionalProperty ;
                 rdfs:domain pokemon:Pokédex ;
                 rdfs:range pokemon:PokédexEntry ;
                 rdfs:comment "A Pokédex entry in which this Pokémon is described." ,
                              "Ein Pokédex Eintrag in welchen über dieses Pokémon informiert wird."@de ;
                 rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
                 rdfs:label "has Pokédex entry" ,
                            "hat Pokédex Eintrag"@de .


pokemon:hasShape a owl:ObjectProperty ;
    rdfs:label "has shape" ;
    rdfs:domain pokemon:Species ;
    rdfs:range pokemon:Shape ;
    skos:inScheme <https://pokemonkg.org/ontology> .

pokemon:hasSize a owl:ObjectProperty ;
         rdfs:label "has size" ;
         skos:inScheme <https://pokemonkg.org/ontology> .


# https://pokemonkg.org/ontology#containsPlace
pokemon:containsPlace a owl:ObjectProperty ;
               owl:inverseOf pokemon:locatedIn ;
               a owl:AsymmetricProperty ,
                        owl:TransitiveProperty ;
               rdfs:domain pokemon:Place ;
               rdfs:range pokemon:Place ;
               rdfs:comment "A place is contained to some extent in this place." ,
                            "Ein Ort ist in gewissem Maße in diesem Ort enthalten."@de ;
               rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
               rdfs:label "beinhaltet Ort"@de ,
                          "contains place" .


# https://pokemonkg.org/ontology#describedInPokédex
pokemon:describedInPokédex a owl:ObjectProperty ;
                    owl:inverseOf pokemon:describesPokémon ;
                    a owl:InverseFunctionalProperty ;
                    rdfs:domain pokemon:Species ;
                    rdfs:range pokemon:PokédexEntry ;
                    rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
                    rdfs:label "described in Pokédex entry" ,
                               "in Pokédex Eintrag beschrieben"@de .


# https://pokemonkg.org/ontology#describesPokémon
pokemon:describesPokémon a owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain pokemon:PokédexEntry ;
                  rdfs:range pokemon:Species ;
                  rdfs:comment "A Pokémon that is described by this Pokédex entry." ,
                               "Ein Pokémon, das von diesem Pokédex Eintrag beschrieben wird."@de ;
                  rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
                  rdfs:label "beschreibt Pokémon"@de ,
                             "describes Pokémon" .


# https://pokemonkg.org/ontology#evolvesFrom
pokemon:evolvesFrom a owl:ObjectProperty ;
             owl:inverseOf pokemon:evolvesTo ;
             rdfs:domain pokemon:Species ;
             rdfs:range pokemon:Species ;
             rdfs:comment "Diese Spezie entwickelt sich von einer anderen Spezies."@de ,
                          "This species evolves from the other species." ;
             rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
             rdfs:label "entwickelt sich von"@de ,
                        "evolves from" .


# https://pokemonkg.org/ontology#evolvesTo
pokemon:evolvesTo a owl:ObjectProperty ;
           rdfs:domain pokemon:Species ;
           rdfs:range pokemon:Species ;
           rdfs:comment "Diese Spezie kann sich in eine andere Spezie entwickeln."@de ,
                        "This species can evolve in another species." ;
           rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
           rdfs:label "entwickelt sich in"@de ,
                      "evolves to" .




#################################################################
#    Data properties
#################################################################

# https://pokemonkg.org/ontology#accuracy
pokemon:accuracy a owl:DatatypeProperty ;
          rdfs:domain pokemon:Move ;
          rdfs:range xsd:integer ;
          rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
          rdfs:label "has accuracy" ,
                     "hat Genauigkeit"@de .


# https://pokemonkg.org/ontology#basePower
pokemon:basePower a owl:DatatypeProperty ;
           rdfs:domain pokemon:Move ;
           rdfs:range xsd:integer ;
           rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
           rdfs:label "has base power" ,
                      "hat Basisstärke"@de .


# https://pokemonkg.org/ontology#basePowerPoints
pokemon:basePowerPoints a owl:DatatypeProperty ;
                 rdfs:subPropertyOf owl:topDataProperty ;
                 rdfs:domain pokemon:Move ;
                 rdfs:range xsd:integer ;
                 rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
                 rdfs:label "has base power points" ,
                            "hat Basis-Angriffspunkte"@de .


# https://pokemonkg.org/ontology#effectDescription
pokemon:effectDescription a owl:DatatypeProperty ;
                   rdfs:domain [ a owl:Class ;
                                 owl:unionOf (pokemon:Ability
                                              pokemon:Move
                                             )
                               ] ;
                   rdfs:label "effect description" .


# https://pokemonkg.org/ontology#entryNumber
pokemon:entryNumber a owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain pokemon:PokédexEntry ;
             rdfs:range xsd:int ;
             rdfs:comment "Der Pokédex Eintrag hat folgende Nummer, die eindeutig sein muss."@de ,
                          "This Pokédex entry has the given number, which has to be unique." ;
             rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
             rdfs:label "has entry number" ,
                        "hat Eintragsnummer"@de .


# https://pokemonkg.org/ontology#firmness
pokemon:firmness a owl:DatatypeProperty ;
          rdfs:domain pokemon:Food ;
          rdfs:range xsd:integer ;
          rdfs:label "has firmness" ,
                     "hat Güte"@de .


# https://pokemonkg.org/ontology#hasGenus
pokemon:hasGenus a owl:DatatypeProperty ;
          rdfs:domain pokemon:Species ;
          rdfs:label "has genus" ,
                     "hat Gattung"@de .


# https://pokemonkg.org/ontology#maxPowerPoints
pokemon:maxPowerPoints a owl:DatatypeProperty ;
                rdfs:domain pokemon:Move ;
                rdfs:range xsd:integer ;
                rdfs:label <https://pokemonkg.org/ontology> ,
                           "has maximum power points" ,
                           "hat maximale Agriffspunkte"@de .


# https://pokemonkg.org/ontology#minLevelToLearn
pokemon:minLevelToLearn a owl:DatatypeProperty ;
                 rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
                 rdfs:label "braucht mininum Level zum Erlernen"@de ,
                            "needs minimum level to learn" .


# https://pokemonkg.org/ontology#smoothness
pokemon:smoothness a owl:DatatypeProperty ;
            rdfs:domain pokemon:Food ;
            rdfs:range xsd:integer ;
            rdfs:label "has smoothness" ,
                       "hat Glätte"@de .


#################################################################
#    Classes
#################################################################

# http://dbpedia.org/ontology/Colour
<http://dbpedia.org/ontology/Colour> a owl:Class .


# http://xmlns.com/foaf/0.1/Person
<http://xmlns.com/foaf/0.1/Person> a owl:Class .


# https://pokemonkg.org/ontology#Ability
pokemon:Ability a owl:Class ;
         owl:disjointUnionOf (pokemon:Flavor
                              pokemon:Generation
                              pokemon:Item
                             ) ;
         rdfs:comment "Abilities were introduced in Generation III as an all new game mechanic. Each and every Pokémon has an ability, and can only have one at a time. Some abilities are exclusive to certain Pokémon and Evolution lines, while others are known by many Pokémon." ,
                      "Fähigkeiten wurden in Generation III als völlig neue Spielmechanik eingeführt. Jeder einzelne Pokémon hat eine Fähigkeit und kann nur eine auf einmal haben. Einige Fähigkeiten sind exklusiv für bestimmte Pokémon- und Evolutionslinien, während andere von vielen Pokémon bekannt sind."@de ;
         rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
         rdfs:label "Ability" ,
                    "Fähigkeit"@de .


pokemon:BattleItem a owl:Class ;
            rdfs:subClassOf pokemon:Item ;
            rdfs:isDefinedBy <https://pokemonkg.org/ontology> .


pokemon:Berry a owl:Class ;
       rdfs:subClassOf pokemon:Food ;
       rdfs:comment "Beeren sind kleine, saftige, fleischige Früchte. Wie in der realen Welt gibt es auch in der Pokémon-Welt eine große Vielfalt mit einer großen Auswahl an Geschmacksrichtungen, Namen und Effekten. Erstmals in den Spielen der Generation II gefunden, sind viele Beeren inzwischen zu kritischen Gegenständen im Kampf geworden, wo ihre verschiedenen Effekte die Wiederherstellung von HP und Statuszustand, Statikverbesserung und sogar Schadensverneinung beinhalten."@de ,
                    "Berries are small, juicy, fleshy fruit. As in the real world, a large variety exists in the Pokémon world, with a large range of flavors, names, and effects. First found in the Generation II games, many Berries have since become critical held items in battle, where their various effects include HP and status condition restoration, stat enhancement, and even damage negation." ;
       rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
       rdfs:label "Beere"@de ,
                  "Berry" .


pokemon:EggGroup a owl:Class ;
          rdfs:comment "Egg group is a category that determines which Pokémon are able to interbreed. The concept was introduced in Generation II, along with breeding. Similar to types, a Pokémon may belong to either one or two egg groups." ;
          rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
          rdfs:label "Egg Group" ,
                     "Ei-Gruppe"@de .


# https://pokemonkg.org/ontology#Flavor
pokemon:Flavor a owl:Class ;
        rdfs:comment "Flavor is a special set of attributes that certain foods in the Pokémon world have. Most of the foods can have more than one flavor attributed to them." ,
                     "Geschmacksrichtung ist ein spezielles Attribut für Nahrung in der Pokémon-Welt. Den meisten Nahrungen können mehr als eine Geschmacksrichtung haben."@de ;
        rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
        rdfs:label "Flavor" ,
                   "Geschmacksrichtung"@de .


# https://pokemonkg.org/ontology#Food
pokemon:Food a owl:Class ;
      rdfs:subClassOf pokemon:Item ;
      rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
      rdfs:label "Food" ,
                 "Nahrung"@de .


# https://pokemonkg.org/ontology#Game
pokemon:Game a owl:Class ;
      rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
      rdfs:label "Game" .


# https://pokemonkg.org/ontology#Generation
pokemon:Generation a owl:Class ;
            rdfs:comment "Generation bezieht sich auf die Pokémon-Spieleserie. Es ist eine Gruppe von Spielen, die zur gleichen Zeit oder etwa zur gleichen Zeit veröffentlicht wurden. Es bedeutet auch, dass Spiele in der gleichen Generation mit den anderen kompatibel sind, die den gleichen Pokémon enthalten und die Anzahl der Züge, die dort gelernt werden müssen."@de ,
                         "Generation refers to the Pokémon game series. It is a group of games that were released at or around the same time. It also means that games in the same generation are compatible with the others, containing the same Pokémon and the number of moves there are to be learned." ;
            rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
            rdfs:label "Generation"@de ,
                       "Generation" .


# https://pokemonkg.org/ontology#Gym
pokemon:Gym a owl:Class ;
     rdfs:subClassOf pokemon:Place ;
     rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
     rdfs:label "Arena"@de ,
                "Gym" .


# https://pokemonkg.org/ontology#GymLeader
pokemon:GymLeader a owl:Class ;
           rdfs:subClassOf pokemon:Trainer ;
           rdfs:comment "A gym leader is the highest-ranking member and owner of an official Pokémon Gym. Gym leaders use their gyms and their Pokémon to test the skills of trainers that challenge them, and if said trainers win a battle, the gym leader will gift them with a badge that's unique to that specific gym." ;
           rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
           rdfs:label "Arenaleiter"@de ,
                      "Gym Leader" .


# https://pokemonkg.org/ontology#HM
pokemon:HM a owl:Class ;
    rdfs:subClassOf pokemon:Item ,
                   pokemon:MoveLearning ;
    rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
    rdfs:label "Hidden Machine" ,
               "Versteckte Maschine"@de .


# https://pokemonkg.org/ontology#Habitat
pokemon:Habitat a owl:Class ;
         rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
         rdfs:label "Habitat" ,
                    "Lebensraum"@de .


# https://pokemonkg.org/ontology#HoldItem
pokemon:HoldItem a owl:Class ;
          rdfs:subClassOf pokemon:Item ;
          rdfs:isDefinedBy <https://pokemonkg.org/ontology> .


# https://pokemonkg.org/ontology#Item
pokemon:Item a owl:Class ;
      rdfs:comment "An item is an object in the Pokémon games which the player can pick up, keep in their Bag, and use in some manner. They have various uses, including healing, powering up, helping one to catch Pokémon, or to access a new area." ,
                   "Ein Gegenstand ist ein Objekt in den Pokémon-Spielen, welches der Spieler aufheben, in seiner Tasche aufbewahren und in irgendeiner Weise verwenden kann. Sie haben verschiedene Verwendungsmöglichkeiten, einschließlich Heilung, Auftanken, Hilfe beim Fangen von Pokémon oder beim Betreten eines neuen Gebietes."@de ;
      rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
      rdfs:label "Item"@de ,
                 "Item" ;
      <http://www.w3.org/2004/02/skos/core#altLabel> "Gegenstand"@de .


# https://pokemonkg.org/ontology#LearningByLevelingUp
pokemon:LearningByLevelingUp a owl:Class ;
                      rdfs:subClassOf pokemon:MoveLearning ;
                      rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
                      rdfs:label "Erlernen durch Aufleveln"@de ,
                                 "Learning by leveling up" .


# https://pokemonkg.org/ontology#LearningThroughBreeding
pokemon:LearningThroughBreeding a owl:Class ;
                         rdfs:subClassOf pokemon:MoveLearning ;
                         rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
                         rdfs:label "Erlernen durch Züchtung"@de ,
                                    "Learning through breeding" .


# https://pokemonkg.org/ontology#Medicine
pokemon:Medicine a owl:Class ;
          rdfs:subClassOf pokemon:Item ;
          rdfs:comment "Medicine items can heal various afflictions of a Pokémon." ,
                       "Medizin kann verschiedene Leiden eines Pokémon heilen."@de ;
          rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
          rdfs:label "Medicine" ,
                     "Medizin"@de .


# https://pokemonkg.org/ontology#Move
pokemon:Move a owl:Class ;
      owl:disjointUnionOf (pokemon:Flavor
                           pokemon:Game
                           pokemon:Generation
                           pokemon:Item
                           pokemon:Place
                           pokemon:Pokédex
                           pokemon:PokédexEntry
                           pokemon:Pokémon
                           pokemon:Region
                           pokemon:Type
                          ) ;
      rdfs:comment "A Move is a technique that a Pokémon uses during Battles. Moves are mainly used to inflict damage on the opponent. Moves usually come from a natural ability that the specific Pokémon has. Some moves can be used both inside and outside of battle. When outside of battle, moves are usually used for transportation or for removing a certain obstacle that the player runs into in the game." ,
                   "Eine Aktion ist eine Technik, die ein Pokémon während eines Kampfes anwendet. Züge werden hauptsächlich verwendet, um dem Gegner Schaden zuzufügen. Züge kommen normalerweise von einer natürlichen Fähigkeit, die der bestimmte Pokémon hat. Einige Züge können sowohl innerhalb als auch außerhalb des Kampfes verwendet werden. Außerhalb des Kampfes werden Züge normalerweise für den Transport oder zum Entfernen eines bestimmten Hindernisses verwendet, auf das der Spieler im Spiel stößt."@de ;
      rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
      rdfs:label "Aktion"@de ,
                 "Move" .


# https://pokemonkg.org/ontology#MoveLearning
pokemon:MoveLearning a owl:Class ;
              rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
              rdfs:label "Aktionserlernen"@de ,
                         "Move learning" .


# https://pokemonkg.org/ontology#PhysicalMove
pokemon:PhysicalMove a owl:Class ;
              rdfs:subClassOf pokemon:Move ;
              rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
              rdfs:label "Physical Move" ,
                         "Physische Aktion"@de .


# https://pokemonkg.org/ontology#Place
pokemon:Place a owl:Class ;
       rdfs:comment "Entities that have a somewhat fixed, physical extension." ,
                    "Entitäten, die eine einigermaßen feste, physische Ausdehnung haben."@de ;
       rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
       rdfs:label "Ort"@de ,
                  "Place" .


# https://pokemonkg.org/ontology#Pokéball
pokemon:Pokéball a owl:Class ;
          rdfs:subClassOf pokemon:Item ;
          rdfs:comment "A Poké Ball is a type of item that is critical to a Trainer's quest, used for catching and storing Pokémon." ,
                       "Ein Poké-Ball ist eine Art von Gegenstand, der für die Aufgabe eines Trainers entscheidend ist und zum Fangen und Aufbewahren von Pokémon verwendet wird."@de ;
          rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
          rdfs:label "Poké Ball"@de ,
                     "Poké Ball" .


# https://pokemonkg.org/ontology#Pokédex
pokemon:Pokédex a owl:Class ;
         owl:disjointUnionOf (pokemon:Pokémon
                              pokemon:Type
                             ) ;
         rdfs:comment "Der Pokédex ist ein elektronisches Gerät, das entwickelt wurde, um die verschiedenen Arten von Pokémon zu katalogisieren und Informationen über sie zu liefern, die in den Videospiel-, Anime und Manga-Serien von Pokémon enthalten sind."@de ,
                      "The Pokédex is an electronic device designed to catalogue and provide information regarding the various species of Pokémon featured in the Pokémon video game, anime and manga series." ;
         rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
         rdfs:label "Pokédex"@de ,
                    "Pokédex" .


# https://pokemonkg.org/ontology#PokédexEntry
pokemon:PokédexEntry a owl:Class ;
              owl:disjointUnionOf (pokemon:Move
                                   pokemon:Pokédex
                                   pokemon:Pokémon
                                   pokemon:Type
                                  ) ;
              rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
              rdfs:label "Pokédex Eintrag"@de ,
                         "Pokédex Entry" .


# https://pokemonkg.org/ontology#Pokémon
pokemon:Pokémon a owl:Class ;
         owl:disjointUnionOf (pokemon:Pokédex
                              pokemon:Type
                             ) ;
         rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
         rdfs:label "Pokémon"@de ,
                    "Pokémon" ;
         rdfs:seeAlso <http://dbpedia.org/resource/Pok%C3%A9mon> .


# https://pokemonkg.org/ontology#Region
pokemon:Region a owl:Class ;
        rdfs:subClassOf pokemon:Place ;
        rdfs:comment "Regionen sind Gebiete im Pokémon-Universum, die kleinere Teile einer Nation darstellen."@de ,
                     "Regions are areas in the Pokémon universe that are smaller parts of a nation." ;
        rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
        rdfs:label "Region"@de ,
                   "Region" .


# https://pokemonkg.org/ontology#Shape
pokemon:Shape a owl:Class ;
       owl:disjointUnionOf (pokemon:Ability
                            pokemon:EggGroup
                            pokemon:Flavor
                            pokemon:Game
                            pokemon:Generation
                            pokemon:Item
                            pokemon:Move
                            pokemon:Place
                            pokemon:Pokédex
                            pokemon:PokédexEntry
                            pokemon:Pokémon
                            pokemon:Species
                            pokemon:Type
                           ) ;
       rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
       rdfs:label "Shape" ,
                  "Silhouette"@de .


# https://pokemonkg.org/ontology#SpecialMove
pokemon:SpecialMove a owl:Class ;
             rdfs:subClassOf pokemon:Move ;
             rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
             rdfs:label "Special Move" ,
                        "Spezialaktion"@de .


# https://pokemonkg.org/ontology#Species
pokemon:Species a owl:Class ;
         owl:disjointUnionOf (pokemon:Ability
                              pokemon:EggGroup
                              pokemon:Flavor
                              pokemon:Game
                              pokemon:Generation
                              pokemon:Item
                              pokemon:Move
                              pokemon:Pokédex
                              pokemon:PokédexEntry
                              pokemon:Pokémon
                              pokemon:Region
                              pokemon:Type
                             ) ;
         rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
         rdfs:label "Species" ,
                    "Spezie"@de .


# https://pokemonkg.org/ontology#StatusMove
pokemon:StatusMove a owl:Class ;
            rdfs:subClassOf pokemon:Move ;
            rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
            rdfs:label "Status Move" ,
                       "Statusaktion"@de .


# https://pokemonkg.org/ontology#TM
pokemon:TM a owl:Class ;
    rdfs:subClassOf pokemon:Item ,
                   pokemon:MoveLearning ;
    rdfs:comment <https://pokemonkg.org/ontology> ,
                 "A Technical Machine, or TM for short is an item that can be used to teach a Pokémon a move." ,
                 "Eine Technische Maschine (TM) verhilft einem Pokémon dazu, eine bestimmte Attacke zu erlernen."@de ;
    rdfs:label "Technical Machine" ,
               "Technische Maschine"@de .


# https://pokemonkg.org/ontology#Town
pokemon:Town a owl:Class ;
      rdfs:subClassOf pokemon:Place ;
      rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
      rdfs:label "Stadt"@de ,
                 "Town" .


# https://pokemonkg.org/ontology#Trainer
pokemon:Trainer a owl:Class ;
         rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person> ;
         rdfs:comment "Pokémon Trainer is a person who catches, occasionally names, and trains different kinds of Pokémon." ,
                      "Pokémon Trainer ist eine Person, die verschiedene Arten von Pokémon fängt, gelegentlich benennt und trainiert."@de ;
         rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
         rdfs:label "Trainer"@de ,
                    "Trainer" .


# https://pokemonkg.org/ontology#Type
pokemon:Type a owl:Class ;
      owl:disjointUnionOf (pokemon:Pokédex
                           pokemon:Pokémon
                          ) ;
      rdfs:comment "All Pokémon creatures and their moves are assigned certain types. Each type has several strengths and weaknesses in both attack and defense." ,
                   "Allen Pokémon-Kreaturen und ihren Attacken werden bestimmte Typen zugeordnet. Jeder Typ hat mehrere Stärken und Schwächen sowohl in Angriff als auch in Verteidigung."@de ;
      rdfs:isDefinedBy <https://pokemonkg.org/ontology> ;
      rdfs:label "Typ"@de ,
                 "Type" .



