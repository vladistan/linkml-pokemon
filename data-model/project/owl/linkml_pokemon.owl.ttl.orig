#################################################################
#    Individuals
#################################################################

pokemon:EggGroup_Amorphous a owl:NamedIndividual,
                             pokemon:EggGroup ;
                    rdfs:label "Amorphous" .


pokemon:EggGroup_Bug a owl:NamedIndividual,
                       pokemon:EggGroup ;
              rdfs:label "Bug" .


pokemon:EggGroup_Ditto a owl:NamedIndividual,
                         pokemon:EggGroup ;
                rdfs:label "Ditto" .


pokemon:EggGroup_Dragon a owl:NamedIndividual,
                          pokemon:EggGroup ;
                 rdfs:label "Dragon" .


pokemon:EggGroup_Fairy a owl:NamedIndividual,
                         pokemon:EggGroup ;
                rdfs:label "Fairy"@en,
                           "Fee"@de .


pokemon:EggGroup_Field a owl:NamedIndividual,
                         pokemon:EggGroup ;
                rdfs:label "Feld"@de,
                           "Field"@en .


# https://pokemonkg.org/ontology#EggGroup_Flying
pokemon:EggGroup_Flying a owl:NamedIndividual,
                          pokemon:EggGroup ;
                 rdfs:label "Flug"@de,
                            "Flying"@en .


# https://pokemonkg.org/ontology#EggGroup_Grass
pokemon:EggGroup_Grass a owl:NamedIndividual,
                         pokemon:EggGroup ;
                rdfs:label "Grass"@en,
                           "Pflanze"@de .


# https://pokemonkg.org/ontology#EggGroup_Human-Like
pokemon:EggGroup_Human-Like a owl:NamedIndividual,
                              pokemon:EggGroup ;
                     rdfs:label "Human-like"@en,
                                "Humanotyp"@de .


# https://pokemonkg.org/ontology#EggGroup_Mineral
pokemon:EggGroup_Mineral a owl:NamedIndividual,
                           pokemon:EggGroup ;
                  rdfs:label "Mineral"@de,
                             "Mineral"@en .


# https://pokemonkg.org/ontology#EggGroup_Monster
pokemon:EggGroup_Monster a owl:NamedIndividual,
                           pokemon:EggGroup ;
                  rdfs:label "Monster"@de,
                             "Monster"@en .


# https://pokemonkg.org/ontology#EggGroup_Undiscovered
pokemon:EggGroup_Undiscovered a owl:NamedIndividual,
                                pokemon:EggGroup ;
                       rdfs:label "No Eggs Discovered"@en,
                                  "Unbekannt"@de .


# https://pokemonkg.org/ontology#EggGroup_Water1
pokemon:EggGroup_Water1 a owl:NamedIndividual,
                          pokemon:EggGroup ;
                 rdfs:label "Wasser 1"@de,
                            "Water 1"@en .


# https://pokemonkg.org/ontology#EggGroup_Water2
pokemon:EggGroup_Water2 a owl:NamedIndividual,
                          pokemon:EggGroup ;
                 rdfs:label "Wasser 2"@de,
                            "Water 2"@en .


# https://pokemonkg.org/ontology#EggGroup_Water3
pokemon:EggGroup_Water3 a owl:NamedIndividual,
                          pokemon:EggGroup ;
                 rdfs:label "Wasser 3"@de,
                            "Water 3"@en .


# https://pokemonkg.org/ontology#Flavor_Bitter
pokemon:Flavor_Bitter a owl:NamedIndividual,
